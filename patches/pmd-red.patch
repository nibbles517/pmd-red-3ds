+
+static const WindowTemplate sNoWindow = { 0, 3, 0, 0, 0, 0, 0, 0, NULL };
+static const WindowHeader sHeader = { 1, 0, 16, 0 };
+// The whole GBA screen, but the frame. (Text windows can't be wider than the
+// GBA screen: their tilemap is 32 tiles wide.)
+static const WindowTemplate sWindow = {
+    0,
+    6,
+    1, 2,
+    28, 17,
+    19, 0,
+    &sHeader
+};
+
+ALIGNED(4) static const u8 sTitle[] = _("Run Options");
+ALIGNED(4) static const u8 sOff[] = _("Off");
+ALIGNED(4) static const u8 sOn[] = _("On");
+ALIGNED(4) static const u8 sHelp[] = _("{COLOR CYAN}Left/Right{RESET}: Off or On   {COLOR CYAN}START{RESET}: Done");
+ALIGNED(4) static const u8 sReady[] = _("Are you ready? You will not be able to\nchange these selections after this!");
+static const u8 *const sNames[PORT_RUN_OPTIONS] = {
+    _("Increased Sitrus Berries"), _("Increased Life Seeds"), _("Increased Vitamins"), _("Option 4"),
+    _("Option 5"), _("Option 6"), _("Option 7"), _("Normalized Shop Prices"), // (and options.c sRunOptionNames)
+};
+#define CHOICE_X(i) (144 + (i) * 40)
+
+static void Draw(void)
+{
+    s32 i, y;
+
+    CallPrepareTextbox_8008C54(0);
+    sub_80073B8(0);
+    PrintStringOnWindow(16, 0, sTitle, 0, 0);
+    for (i = 0; i < PORT_RUN_OPTIONS; i++) {
+        y = GetMenuEntryYCoord(&sRun.input, i);
+        PrintStringOnWindow(8, y, sNames[i], 0, 0);
+        PrintStringOnWindow(CHOICE_X(0), y, sOff, 0, 0);
+        PrintStringOnWindow(CHOICE_X(1), y, sOn, 0, 0);
+        AddDoubleUnderScoreHighlight(0, CHOICE_X(gPortRunOptions[i] ? 1 : 0), y + 10,
+                                     GetStringLineWidth(gPortRunOptions[i] ? sOn : sOff), COLOR_WHITE_2);
+    }
+    PrintStringOnWindow(8, GetMenuEntryYCoord(&sRun.input, PORT_RUN_OPTIONS - 1) + 20, sHelp, 0, 0);
+    sub_80073E0(0);
+}
+
+// The options window, cursor on `entry`
+static void ShowOptions(s32 entry)
+{
+    sRun.windows.id[0] = sWindow;
+    sRun.windows.id[1] = sNoWindow;
+    sRun.windows.id[2] = sNoWindow;
+    sRun.windows.id[3] = sNoWindow;
+    ResetUnusedInputStruct();
+    ShowWindows(&sRun.windows, TRUE, TRUE);
+    CreateMenuOnWindow(&sRun.input, PORT_RUN_OPTIONS, PORT_RUN_OPTIONS, 0);
+    MoveMenuToEntryId(&sRun.input, entry);
+    sRun.input.entryHeight = 12 << 8;
+    Draw();
+}
+
+// The question in the message box, with the Yes/No window (cursor on No)
+static void Ask(void)
+{
+    sRun.answers[0].text = gCommonYes[0];
+    sRun.answers[0].menuAction = ANSWER_YES;
+    sRun.answers[1].text = gCommonNo[0];
+    sRun.answers[1].menuAction = ANSWER_NO;
+    sRun.answers[2].text = NULL;
+    sRun.answers[2].menuAction = 0;
+    CreateMenuDialogueBoxAndPortrait(sReady, NULL, ANSWER_NO, sRun.answers, NULL, 4, 0, NULL,
+                                     STR_FORMAT_FLAG_INSTANT_TEXT);
+}
+
+// Runs until the player says Yes to the question; frameActions draws a frame
+// and waits for the next one (it also runs the message box).
+void PortNewRun_Run(void (*frameActions)(u32))
+{
+    bool8 asking = FALSE;
+
+    memset(gPortRunOptions, 0, sizeof(gPortRunOptions));
+    ShowOptions(0);
+    while (TRUE) {
+        s32 index = sRun.input.menuIndex;
+        s32 input;
+        bool8 redraw = FALSE;
+
+        frameActions(0);
+        if (asking) {
+            s32 answer;
+
+            if (sub_80144A4(&answer) != 0)
+                continue; // (still asking)
+            if (answer == ANSWER_YES) {
+                Port_RunOptionsChosen(); // (its Save Data's at the first save)
+                break;
+            }
+            asking = FALSE;
+            ShowOptions(0);
+            continue;
+        }
+        input = GetMenuInput();
+        if (input == INPUT_START_BUTTON) {
+            PlayMenuSoundEffect(MENU_SFX_ACCEPT);
+            asking = TRUE;
+            Ask();
+            continue;
+        }
+        if (input == INPUT_DPAD_LEFT || input == INPUT_DPAD_RIGHT || input == INPUT_A_BUTTON) {
+            u8 on = input == INPUT_DPAD_RIGHT ? 1 : input == INPUT_DPAD_LEFT ? 0 : !gPortRunOptions[index];
+            if (on != gPortRunOptions[index]) {
+                gPortRunOptions[index] = on;
+                PlayMenuSoundEffect(MENU_SFX_NAVIGATE);
+                redraw = TRUE;
+            }
+        }
+        if (MenuCursorUpdate(&sRun.input, TRUE) || redraw)
+            Draw();
+    }
+    sRun.windows.id[0] = sNoWindow;
+    ResetUnusedInputStruct();
+    ShowWindows(&sRun.windows, TRUE, TRUE);
+    frameActions(0);
+}
+
+#endif // PLATFORM_3DS
diff --git a/src/port_screen_menu.c b/src/port_screen_menu.c
