diff --git a/src/port_cheats.c b/src/port_cheats.c
new file mode 100644
index 00000000..e5a595bb
--- /dev/null
+++ b/src/port_cheats.c
@@ -0,0 +1,121 @@
+// 3DS port: Others > Cheats (in dungeons). The menu is in
+// dungeon_menu_others.c; the settings (gPortCheats, each Save Data's own) in
+// port/core/options.c. What they do, here and where the game asks:
+//   Infinite HP      the team's HP 999, kept there (PortCheats_Turn; and
+//                    after each hit, dungeon_damage.c)
+//   Infinite PP      the team's moves' PP 99, kept there (PortCheats_Turn)
+//   Infinite Belly   the leader's Belly 200, kept there (PortCheats_Turn)
+//   One-Hit KOs      the team's damaging moves do 1000 (CalcDamage)
+//   100% Accuracy    the team's moves never miss (AccuracyCalc)
+//   Exp. Multiplier  the team's Exp. Points 2x-128x, or none at all with 0x
+//                    (AddExpPoints)
+//   Learn Any TM/HM  any Pokémon can learn any TM or HM (CanMonLearnMove)
+//   100% Recruit Rate  a Pokémon the leader defeats always asks to join,
+//                    whether or not its friend area is had or the dungeon
+//                    lets Pokémon join (TryRecruitMonster)
+//   Permanent X-Ray Specs, No-Stick Cap, Goggle Specs, Weather Band, Twist
+//                    Band, Mobile Scarf, Pierce Band, Sneak Scarf: the team
+//                    as if each held one (HasHeldItem)
+//   Permanent Luminous Orb  each floor's map shown, as the orb shows it
+//                    (PortCheats_Turn)
+#include "global.h"
+#include "globaldata.h"
+#include "constants/item.h"
+#include "dungeon_map.h"
+#include "dungeon_map_access.h"
+#include "dungeon_tilemap.h"
+#include "dungeon_util.h"
+#include "moves.h"
+#include "number_util.h"
+#include "port_new_run.h"
+#include "structs/str_dungeon.h"
+
+#ifdef PLATFORM_3DS
+
+bool8 PortCheats_TeamMember(Entity *entity)
+{
+    return entity != NULL && EntityIsValid(entity) && GetEntityType(entity) == ENTITY_MONSTER
+        && !GetEntInfo(entity)->isNotTeamMember;
+}
+
+// HasHeldItem: the team as if holding the cheats' items
+bool8 PortCheats_HeldItem(Entity *entity, u8 id)
+{
+    s32 cheat;
+    switch (id) {
+        case ITEM_X_RAY_SPECS: cheat = CHEAT_XRAY; break;
+        case ITEM_NOSTICK_CAP: cheat = CHEAT_NOSTICK; break;
+        case ITEM_GOGGLE_SPECS: cheat = CHEAT_GOGGLE; break;
+        case ITEM_WEATHER_BAND: cheat = CHEAT_WEATHER; break;
+        case ITEM_TWIST_BAND: cheat = CHEAT_TWIST; break;
+        case ITEM_MOBILE_SCARF: cheat = CHEAT_MOBILE; break;
+        case ITEM_PIERCE_BAND: cheat = CHEAT_PIERCE; break;
+        case ITEM_SNEAK_SCARF: cheat = CHEAT_SNEAK; break;
+        default: return FALSE;
+    }
+    return gPortCheats[cheat] && PortCheats_TeamMember(entity);
+}
+
+// AddExpPoints: a team member's Exp. Points multiplied
+s32 PortCheats_Exp(Entity *receiver, s32 exp)
+{
+    s32 shift = gPortCheats[CHEAT_EXP] - 1; // (2x: 1)
+    if (gPortCheats[CHEAT_EXP] == 0 || gPortCheats[CHEAT_EXP] > CHEAT_EXP_MAX || exp <= 0 || !PortCheats_TeamMember(receiver))
+        return exp;
+    if (gPortCheats[CHEAT_EXP] == CHEAT_EXP_NONE)
+        return 0; // (0x: none gained)
+    if (exp > (9999999 >> shift))
+        return 9999999;
+    return exp << shift;
+}
+
+// Infinite HP: after a hit on a team member (dungeon_damage.c)
+void PortCheats_KeepHP(Entity *target)
+{
+    if (gPortCheats[CHEAT_INF_HP] && PortCheats_TeamMember(target))
+        GetEntInfo(target)->HP = 999;
+}
+
+static bool8 sXRayShown; // (Permanent X-Ray Specs: the camera made again when it changes)
+
+// Every turn (run_dungeon.c), and when the Cheats menu closes
+void PortCheats_Turn(void)
+{
+    s32 i, k;
+
+    if (gDungeon == NULL)
+        return;
+    for (i = 0; i < MAX_TEAM_MEMBERS; i++) {
+        Entity *e = gDungeon->teamPokemon[i];
+        EntityInfo *info;
+        if (!PortCheats_TeamMember(e))
+            continue;
+        info = GetEntInfo(e);
+        if (gPortCheats[CHEAT_INF_HP] && info->HP > 0)
+            info->HP = 999;
+        if (gPortCheats[CHEAT_INF_PP])
+            for (k = 0; k < MAX_MON_MOVES; k++)
+                if (MoveFlagExists(&info->moves.moves[k]))
+                    info->moves.moves[k].PP = 99;
+        if (gPortCheats[CHEAT_INF_BELLY] && info->isTeamLeader)
+            info->belly = IntToFixedPoint(200);
+    }
+    // Permanent Luminous Orb: as the orb shows the floor (no message)
+    if (gPortCheats[CHEAT_LUMINOUS] && !gDungeon->unk181e8.allTilesRevealed) {
+        s32 x, y;
+        gDungeon->unk181e8.allTilesRevealed = TRUE;
+        for (y = 0; y < DUNGEON_MAX_SIZE_Y; y++)
+            for (x = 0; x < DUNGEON_MAX_SIZE_X; x++)
+                GetTileMut(x, y)->spawnOrVisibilityFlags.visibility |= VISIBILITY_FLAG_REVEALED;
+        UpdateCamera(0);
+        UpdateTrapsVisibility();
+        UpdateMinimap();
+    }
+    if (sXRayShown != (gPortCheats[CHEAT_XRAY] != 0)) {
+        sXRayShown = gPortCheats[CHEAT_XRAY] != 0;
+        UpdateCamera(1);
+        UpdateMinimap();
+    }
+}
+
+#endif
diff --git a/src/port_extra_music.c b/src/port_extra_music.c
new file mode 100644
index 00000000..da5be0fc
--- /dev/null
+++ b/src/port_extra_music.c
@@ -0,0 +1,72 @@
+// 3DS port: Music Options > Extra Music. On the dungeon floors the port gives
+// a song for (port/core/music.c: Port_ExtraMusicFor, or extra-music.txt),
+// Explorers of Sky's song plays instead of the floor's own music, from that
+// game's ROM (picked in Music Options); or one of the game's own songs, where
+// a floor keeps a song on for longer than the game does. Only the floor's music: a Monster
+// House, a boss, the fanfares and the rest play as ever. music.c plays it in
+// the background music's DS slot (as Music Style: DS plays its tracks).
+#include "global.h"
+#include "globaldata.h"
+#include "constants/bg_music.h"
+#include "dungeon_config.h"
+#include "structs/str_dungeon.h"
+#include "port_game.h"
+
+#ifdef PLATFORM_3DS
+
+#define EXTRA_GBA 0x8000 // (Port_ExtraMusicFor: one of the game's own songs)
+
+// The floor's song (Port_ExtraMusicFor) if `song` is the floor's own music
+// and Extra Music is on, else -1
+static s32 FloorSong(u16 song)
+{
+    if (!gPortConfig.extraMusic || gDungeon == NULL || song == STOP_BGM)
+        return -1;
+    if (gDungeon->unk3A10 < 0 || gDungeon->unk3A10 >= (s32)ARRAY_COUNT(gDungeonMusic)
+        || song != (u16)gDungeonMusic[gDungeon->unk3A10])
+        return -1; // (not the floor's own music)
+    // (the floor as shown: 1F, B5F..., the dungeon's starting floor counted)
+    return Port_ExtraMusicFor(gDungeon->unk644.dungeonLocation.id, gDungeon->startFloorId + gDungeon->unk644.dungeonLocation.floor);
+}
+
+#define DUNGEON_MUSIC_FADE_IN 0x8000 // (dungeon_music.c)
+static u16 sLastFloorSong = STOP_BGM; // (the last floor's own music, still asked for as the next floor starts)
+
+// The Explorers of Sky song (slot track) this floor plays now, or -1: while
+// the dungeon's music is the floor's own (not a Monster House's, a boss's, a
+// shop's, a thief's...; and on, unbroken, as the next floor starts, so the
+// same song plays on from floor to floor). music.c fades from one to the next.
+s32 Port_ExtraMusicWant(void)
+{
+    u16 queued, floorSong;
+    s32 n;
+
+    if (!gPortConfig.extraMusic || gDungeon == NULL) {
+        sLastFloorSong = STOP_BGM;
+        return -1;
+    }
+    if (gDungeon->unk644.bossSongIndex != STOP_BGM || gDungeon->unk644.unk2B != 0
+        || gDungeon->unk644.monsterHouseTriggeredEvent || gDungeon->unk644.unk55 != 0)
+        return -1; // (the game's music for those)
+    if (gDungeon->unk3A10 < 0 || gDungeon->unk3A10 >= (s32)ARRAY_COUNT(gDungeonMusic))
+        return -1;
+    floorSong = (u16)gDungeonMusic[gDungeon->unk3A10];
+    queued = gDungeon->musPlayer.queuedSongIndex & ~DUNGEON_MUSIC_FADE_IN;
+    if (queued == floorSong)
+        sLastFloorSong = floorSong;
+    else if (queued == STOP_BGM || queued != sLastFloorSong)
+        return -1; // (its music stopped: the dungeon's end...)
+    n = Port_ExtraMusicFor(gDungeon->unk644.dungeonLocation.id, gDungeon->startFloorId + gDungeon->unk644.dungeonLocation.floor);
+    return n < 0 || (n & EXTRA_GBA) ? -1 : Port_ExtraMusicTrack(n);
+}
+
+// The song to start in place of `song` (StartNewBGM etc.): one of the game's
+// own, where the floor keeps a song on for longer than the game does
+// (Buried Relic's, Stormy Sea's); else `song`
+u16 Port_ExtraMusicSwap(u16 song)
+{
+    s32 n = FloorSong(song);
+    return n >= 0 && (n & EXTRA_GBA) ? (u16)(n & ~EXTRA_GBA) : song;
+}
+
+#endif
diff --git a/src/port_new_run.c b/src/port_new_run.c
new file mode 100644
index 00000000..23e8ad99
--- /dev/null
+++ b/src/port_new_run.c
@@ -0,0 +1,164 @@
+// 3DS port: the run options, chosen once when a new adventure starts.
+//
+// After New Game (main_loops.c), before the personality quiz: a window over
+// the whole screen with the Off/On options (sShown) (Left/Right or A to toggle), START to
+// finish. Then the game's own message box asks "Are you ready? You will not be
+// able to change these selections after this!" with its small Yes/No window
+// (as the options menu's old "Change settings?"): Yes goes on to the quiz, No
+// or B back to the options. What the options do: port_new_run.h (gPortRunOptions). They
+// can't be changed in the game after that; config.ini keeps them per Save Data.
+#include <string.h>
+#include "global.h"
+#include "globaldata.h"
+#include "common_strings.h"
+#include "constants/colors.h"
+#include "constants/input.h"
+#include "music_util.h"
+#include "input.h"
+#include "menu_input.h"
+#include "port_game.h"
+#include "port_new_run.h"
+#include "string_format.h"
+#include "text_1.h"
+#include "text_2.h"
+#include "text_3.h"
+
+#ifdef PLATFORM_3DS
+
+// (gPortRunOptions: port/core/options.c, which keeps each Save Data's in
+// config.ini)
+
+enum { ANSWER_YES = 1, ANSWER_NO };
+
+static struct {
+    MenuInputStruct input;
+    WindowTemplates windows;
+    MenuItem answers[3];
+} sRun;
+
+static const WindowTemplate sNoWindow = { 0, 3, 0, 0, 0, 0, 0, 0, NULL };
+static const WindowHeader sHeader = { 1, 0, 16, 0 };
+// The whole GBA screen, but the frame. (Text windows can't be wider than the
+// GBA screen: their tilemap is 32 tiles wide.)
+static const WindowTemplate sWindow = {
+    0,
+    6,
+    1, 2,
+    28, 17,
+    19, 0,
+    &sHeader
+};
+
+ALIGNED(4) static const u8 sTitle[] = _("Run Options");
+ALIGNED(4) static const u8 sOff[] = _("Off");
+ALIGNED(4) static const u8 sOn[] = _("On");
+ALIGNED(4) static const u8 sHelp[] = _("{COLOR CYAN}Left/Right{RESET}: Off or On   {COLOR CYAN}START{RESET}: Done");
+ALIGNED(4) static const u8 sReady[] = _("Are you ready? You will not be able to\nchange these selections after this!");
+static const u8 *const sNames[PORT_RUN_OPTIONS] = {
+    _("Increased Sitrus Berries"), _("Increased Life Seeds"), _("Increased Vitamins"), _("Blue Exclusive Pokémon"),
+    _("Shiny Pokémon"), _("Option 6"), _("Option 7"), _("Normalized Shop Prices"), // (and options.c sRunOptionNames)
+};
+// The options the menu shows, in order (Option 6 and 7 do nothing yet: hidden)
+static const u8 sShown[] = { 0, 1, 2, 3, 4, 7 };
+#define SHOWN_COUNT ((s32)ARRAY_COUNT(sShown))
+#define CHOICE_X(i) (144 + (i) * 40)
+
+static void Draw(void)
+{
+    s32 i, y;
+
+    CallPrepareTextbox_8008C54(0);
+    sub_80073B8(0);
+    PrintStringOnWindow(16, 0, sTitle, 0, 0);
+    for (i = 0; i < SHOWN_COUNT; i++) {
+        u8 on = gPortRunOptions[sShown[i]];
+        y = GetMenuEntryYCoord(&sRun.input, i);
+        PrintStringOnWindow(8, y, sNames[sShown[i]], 0, 0);
+        PrintStringOnWindow(CHOICE_X(0), y, sOff, 0, 0);
+        PrintStringOnWindow(CHOICE_X(1), y, sOn, 0, 0);
+        AddDoubleUnderScoreHighlight(0, CHOICE_X(on ? 1 : 0), y + 10, GetStringLineWidth(on ? sOn : sOff), COLOR_WHITE_2);
+    }
+    PrintStringOnWindow(8, GetMenuEntryYCoord(&sRun.input, SHOWN_COUNT - 1) + 20, sHelp, 0, 0);
+    sub_80073E0(0);
+}
+
+// The options window, cursor on `entry`
+static void ShowOptions(s32 entry)
+{
+    sRun.windows.id[0] = sWindow;
+    sRun.windows.id[1] = sNoWindow;
+    sRun.windows.id[2] = sNoWindow;
+    sRun.windows.id[3] = sNoWindow;
+    ResetUnusedInputStruct();
+    ShowWindows(&sRun.windows, TRUE, TRUE);
+    CreateMenuOnWindow(&sRun.input, SHOWN_COUNT, SHOWN_COUNT, 0);
+    MoveMenuToEntryId(&sRun.input, entry);
+    sRun.input.entryHeight = 12 << 8;
+    Draw();
+}
+
+// The question in the message box, with the Yes/No window (cursor on No)
+static void Ask(void)
+{
+    sRun.answers[0].text = gCommonYes[0];
+    sRun.answers[0].menuAction = ANSWER_YES;
+    sRun.answers[1].text = gCommonNo[0];
+    sRun.answers[1].menuAction = ANSWER_NO;
+    sRun.answers[2].text = NULL;
+    sRun.answers[2].menuAction = 0;
+    CreateMenuDialogueBoxAndPortrait(sReady, NULL, ANSWER_NO, sRun.answers, NULL, 4, 0, NULL,
+                                     STR_FORMAT_FLAG_INSTANT_TEXT);
+}
+
+// Runs until the player says Yes to the question; frameActions draws a frame
+// and waits for the next one (it also runs the message box).
+void PortNewRun_Run(void (*frameActions)(u32))
+{
+    bool8 asking = FALSE;
+
+    memset(gPortRunOptions, 0, sizeof(gPortRunOptions));
+    ShowOptions(0);
+    while (TRUE) {
+        s32 index = sShown[sRun.input.menuIndex];
+        s32 input;
+        bool8 redraw = FALSE;
+
+        frameActions(0);
+        if (asking) {
+            s32 answer;
+
+            if (sub_80144A4(&answer) != 0)
+                continue; // (still asking)
+            if (answer == ANSWER_YES) {
+                Port_RunOptionsChosen(); // (its Save Data's at the first save)
+                break;
+            }
+            asking = FALSE;
+            ShowOptions(0);
+            continue;
+        }
+        input = GetMenuInput();
+        if (input == INPUT_START_BUTTON) {
+            PlayMenuSoundEffect(MENU_SFX_ACCEPT);
+            asking = TRUE;
+            Ask();
+            continue;
+        }
+        if (input == INPUT_DPAD_LEFT || input == INPUT_DPAD_RIGHT || input == INPUT_A_BUTTON) {
+            u8 on = input == INPUT_DPAD_RIGHT ? 1 : input == INPUT_DPAD_LEFT ? 0 : !gPortRunOptions[index];
+            if (on != gPortRunOptions[index]) {
+                gPortRunOptions[index] = on;
+                PlayMenuSoundEffect(MENU_SFX_NAVIGATE);
+                redraw = TRUE;
+            }
+        }
+        if (MenuCursorUpdate(&sRun.input, TRUE) || redraw)
+            Draw();
+    }
+    sRun.windows.id[0] = sNoWindow;
+    ResetUnusedInputStruct();
+    ShowWindows(&sRun.windows, TRUE, TRUE);
+    frameActions(0);
+}
+
+#endif // PLATFORM_3DS
diff --git a/src/port_screen_menu.c b/src/port_screen_menu.c
new file mode 100644
index 00000000..189cd504
--- /dev/null
+++ b/src/port_screen_menu.c
@@ -0,0 +1,529 @@
+// 3DS port: Others > Graphics Options (outside dungeons).
+//
+// Built like the game's own Game Options window (options_menu2.c):
+//   Frame Skip             Off / Auto / Always (port/core/frame.c)
+//   Dual Core              Off / On: the second CPU core makes the DS music
+//                          and sound effects (port/core/music.c)
+//   GPU Drawing            Off / On: the main screen drawn by the GPU, from the
+//                          drawing list (port/core/gpulist.h, docs/GPU.md)
+//   Main Screen            Top / Bottom (kept in the save's game options, in the
+//                          bit the DS version uses for its touch screen option:
+//                          clear = bottom, set = top)
+//   Main Screen Settings   a page of two toggles, Size (GBA/DS/3DS) and
+//                          Scale (None/Full/Stretch: 1:1, as large as fits,
+//                          the whole screen; port/3ds/main.c ScaleRect)
+//   Sub-Screen Settings    Enabled? (Yes/No: turns the second screen on/off),
+//                          then the same Size and Scale
+// The page settings live in the port's own config file (gPortConfig). Every
+// toggle takes effect as soon as it changes; the file is written when the
+// menu is left (options_menu1.c, "Changes saved."). On the title's main menu
+// (deferred), Graphics Options changes nothing until it is left: then the
+// file is written, the menu fades out and comes back with them
+// (PortScreenMenu_Commit, main_loops.c).
+#include <stdio.h>
+#include <string.h>
+#include "global.h"
+#include "globaldata.h"
+#include "constants/colors.h"
+#include "constants/input.h"
+#include "music_util.h"
+#include "input.h"
+#include "menu_input.h"
+#include "port_screen_menu.h"
+#include "game_options.h"
+#include "save.h"
+#include "port_game.h"
+#include "text_1.h"
+#include "text_2.h"
+#include "text_3.h"
+
+#ifdef PLATFORM_3DS
+
+enum { PAGE_TOP, PAGE_MAIN_SCREEN, PAGE_SUB_SCREEN, PAGE_CONTROLS, PAGE_MUSIC };
+// First page entries
+enum { TOP_FRAMESKIP, TOP_DUALCORE, TOP_GPU, TOP_BUSY, TOP_MAIN_SCREEN, TOP_MAIN_SETTINGS, TOP_SUB_SETTINGS };
+
+#define TOP_ENTRIES 7
+#define MAX_CHOICES 4
+
+enum { SETTING_ENABLED, SETTING_SIZE, SETTING_SCALE, SETTING_FRAMESKIP, SETTING_BUTTONS, SETTING_TOUCH, SETTING_MUSIC_STYLE, SETTING_SFX_STYLE, SETTING_EXTRA_MUSIC };
+// Music Options: Music Style, ..., then Music Player (no choices: opens the player)
+enum { MUSIC_STYLE, MUSIC_SFX, MUSIC_VOLUME, MUSIC_SFX_VOLUME, MUSIC_EXTRA, MUSIC_EXTRA_VOLUME, MUSIC_EXTRA_TRACKS, MUSIC_PLAYER };
+_Static_assert(MUSIC_EXTRA == PORT_MUSIC_ENTRY_EXTRA && MUSIC_EXTRA_TRACKS == PORT_MUSIC_ENTRY_EXTRA_TRACKS
+               && MUSIC_PLAYER == PORT_MUSIC_ENTRY_PLAYER, "port_screen_menu.h");
+// (entries that aren't settings with choices: EntrySetting's)
+enum { ENTRY_PLAYER = -1, ENTRY_MUSIC_VOLUME = -2, ENTRY_SFX_VOLUME = -3, ENTRY_EXTRA_VOLUME = -4, ENTRY_EXTRA_TRACKS = -5 };
+
+static struct {
+    GameOptions *options;
+    MenuInputStruct input;
+    u32 windowId;
+    WindowTemplates windows;
+    s32 page;
+    struct PortConfig startConfig; // the settings when the menu was opened
+    bool8 musicLocked; // Music Options for another game's ROM: GBA music only
+    bool8 deferred; // the title's Graphics Options: the settings changed in `pending` (and pendingTop)
+    struct PortConfig pending;
+    u8 pendingTop;
+    struct PortConfig *cfg; // the settings changed: gPortConfig, or pending
+} sMenu;
+#define CFG (*sMenu.cfg)
+
+static const WindowTemplate sNoWindow = { 0, 3, 0, 0, 0, 0, 0, 0, NULL };
+static const WindowHeader sHeader = { 1, 0, 15, 0 };
+static const WindowTemplate sWindow = {
+    0,
+    6,
+    2, 2,
+    26, 16, // wide enough for four Size choices
+    18, 0,
+    &sHeader
+};
+
+ALIGNED(4) static const u8 sTitleTop[] = _("Graphics Options");
+ALIGNED(4) static const u8 sTitleMain[] = _("Main Screen Settings");
+ALIGNED(4) static const u8 sTitleSub[] = _("Sub-Screen Settings");
+ALIGNED(4) static const u8 sFrameSkip[] = _("Frame Skip");
+ALIGNED(4) static const u8 sOff[] = _("Off");
+ALIGNED(4) static const u8 sAuto[] = _("Auto");
+ALIGNED(4) static const u8 sAlways[] = _("Always");
+ALIGNED(4) static const u8 sDualCore[] = _("Dual Core");
+ALIGNED(4) static const u8 sGpuDraw[] = _("GPU Drawing");
+ALIGNED(4) static const u8 sBusy[] = _("Busy Screen");
+ALIGNED(4) static const u8 sWait[] = _("Wait");
+ALIGNED(4) static const u8 sSkip[] = _("Skip");
+ALIGNED(4) static const u8 sOn[] = _("On");
+ALIGNED(4) static const u8 sMainScreen[] = _("Main Screen{MOVE_X_POSITION_BY_80}Top{MOVE_X_POSITION_BY_120}Bottom");
+ALIGNED(4) static const u8 sTop[] = _("Top");
+ALIGNED(4) static const u8 sBottom[] = _("Bottom");
+ALIGNED(4) static const u8 sMainScreenSettings[] = _("Main Screen Settings");
+ALIGNED(4) static const u8 sSubScreenSettings[] = _("Sub-Screen Settings");
+ALIGNED(4) static const u8 sEnabled[] = _("Enabled?");
+ALIGNED(4) static const u8 sYes[] = _("Yes");
+ALIGNED(4) static const u8 sNo[] = _("No");
+ALIGNED(4) static const u8 sSize[] = _("Size");
+ALIGNED(4) static const u8 sScale[] = _("Scale");
+ALIGNED(4) static const u8 sSizeGBA[] = _("GBA");
+ALIGNED(4) static const u8 sSizeDS[] = _("DS");
+ALIGNED(4) static const u8 sSizeFit[] = _("Fit");
+ALIGNED(4) static const u8 sSize3DS[] = _("3DS");
+ALIGNED(4) static const u8 sScaleNone[] = _("None");
+ALIGNED(4) static const u8 sScaleFull[] = _("Full");
+ALIGNED(4) static const u8 sScaleStretch[] = _("Stretch");
+ALIGNED(4) static const u8 sTitleControls[] = _("Controls Options");
+ALIGNED(4) static const u8 sButtonStyle[] = _("Button Style");
+ALIGNED(4) static const u8 sTouchScreen[] = _("Touch Screen");
+ALIGNED(4) static const u8 sTitleMusic[] = _("Music Options");
+ALIGNED(4) static const u8 sMusicStyle[] = _("Music Style");
+ALIGNED(4) static const u8 sMusicPlayer[] = _("Music Player");
+ALIGNED(4) static const u8 sSfxStyle[] = _("Sound Effects");
+ALIGNED(4) static const u8 sExtraMusic[] = _("Extra Music");
+ALIGNED(4) static const u8 sMusicVolume[] = _("Music Volume");
+ALIGNED(4) static const u8 sSfxVolume[] = _("SFX Volume");
+ALIGNED(4) static const u8 sExtraVolume[] = _("Extra Volume");
+ALIGNED(4) static const u8 sExtraTracks[] = _("Extra Music Volumes");
+#define VOLUME_MIN 1 // (tens of percent, as gPortConfig.musicVolume / sfxVolume)
+#define VOLUME_MAX 40
+static const struct {
+    const u8 *name;
+    u8 count;
+    const u8 *choices[MAX_CHOICES];
+} sSettings[] = {
+    [SETTING_ENABLED] = { sEnabled, 2, { sYes, sNo } },
+    [SETTING_SIZE] = { sSize, 4, { sSizeGBA, sSizeDS, sSizeFit, sSize3DS } },
+    [SETTING_SCALE] = { sScale, 3, { sScaleNone, sScaleFull, sScaleStretch } },
+    [SETTING_FRAMESKIP] = { sFrameSkip, 3, { sOff, sAuto, sAlways } },
+    [SETTING_BUTTONS] = { sButtonStyle, 2, { sSizeGBA, sSizeDS } },
+    [SETTING_TOUCH] = { sTouchScreen, 2, { sOn, sOff } },
+    [SETTING_MUSIC_STYLE] = { sMusicStyle, 2, { sSizeGBA, sSizeDS } },
+    [SETTING_SFX_STYLE] = { sSfxStyle, 2, { sSizeGBA, sSizeDS } },
+    [SETTING_EXTRA_MUSIC] = { sExtraMusic, 2, { sOff, sOn } },
+};
+// (Controls Options: further right, past the longer names)
+#define CHOICE_X(i) (sMenu.page == PAGE_CONTROLS || sMenu.page == PAGE_MUSIC ? 96 + (i) * 32 : 64 + (i) * 40)
+#define FRAMESKIP_X(i) (80 + (i) * 40) // as Main Screen's choices
+
+static s32 EntryCount(void)
+{
+    switch (sMenu.page) {
+        case PAGE_TOP: return TOP_ENTRIES;
+        case PAGE_SUB_SCREEN: return 3;
+        case PAGE_CONTROLS: return 1;
+        case PAGE_MUSIC: return 8;
+        default: return 2;
+    }
+}
+
+// Which setting entry `i` of the current settings page is.
+static s32 EntrySetting(s32 i)
+{
+    if (sMenu.page == PAGE_CONTROLS)
+        return SETTING_BUTTONS + i;
+    if (sMenu.page == PAGE_MUSIC)
+        return i == MUSIC_STYLE ? SETTING_MUSIC_STYLE : i == MUSIC_SFX ? SETTING_SFX_STYLE : i == MUSIC_EXTRA ? SETTING_EXTRA_MUSIC
+             : i == MUSIC_VOLUME ? ENTRY_MUSIC_VOLUME : i == MUSIC_SFX_VOLUME ? ENTRY_SFX_VOLUME
+             : i == MUSIC_EXTRA_VOLUME ? ENTRY_EXTRA_VOLUME : i == MUSIC_EXTRA_TRACKS ? ENTRY_EXTRA_TRACKS : ENTRY_PLAYER;
+    return sMenu.page == PAGE_SUB_SCREEN ? i : i + 1;
+}
+
+static u8 *SettingValue(s32 setting)
+{
+    s32 screen = sMenu.page == PAGE_MAIN_SCREEN ? 0 : 1;
+    if (setting == SETTING_BUTTONS)
+        return &CFG.buttonStyle;
+    if (setting == SETTING_TOUCH)
+        return &CFG.touchScreenOff;
+    if (setting == SETTING_MUSIC_STYLE)
+        return &CFG.musicStyle;
+    if (setting == SETTING_SFX_STYLE)
+        return &CFG.sfxStyle;
+    if (setting == SETTING_EXTRA_MUSIC)
+        return &CFG.extraMusic;
+    if (setting == SETTING_ENABLED)
+        return &CFG.subScreenDisabled;
+    if (setting == SETTING_FRAMESKIP)
+        return &CFG.frameSkip;
+    return &CFG.layout[screen][setting - SETTING_SIZE];
+}
+
+// The first choice a setting offers on this page: the second screen has no
+// GBA size (it is always DS-sized), so its Size starts at DS.
+static s32 FirstChoice(s32 setting)
+{
+    return setting == SETTING_SIZE && sMenu.page == PAGE_SUB_SCREEN ? PORT_SIZE_DS : 0;
+}
+
+// Settings (setting, or one of its choices) that do nothing yet are shown in
+// red: the 3DS size for the second screen.
+static bool8 IsPlaceholder(s32 setting, s32 choice)
+{
+    if (setting == SETTING_MUSIC_STYLE || setting == SETTING_SFX_STYLE || setting == SETTING_EXTRA_MUSIC) // another game's ROM: not to be chosen
+        return sMenu.musicLocked;
+    if (setting == SETTING_SIZE)
+        return choice == PORT_SIZE_3DS && sMenu.page == PAGE_SUB_SCREEN;
+    return FALSE;
+}
+
+ALIGNED(4) static const u8 sRed[] = _("{COLOR RED}");
+
+static void PrintText(s32 x, s32 y, const u8 *str, u32 win, bool8 red)
+{
+    u8 buf[64];
+    if (red) {
+        s32 n = 0, i;
+        for (i = 0; sRed[i] != 0 && n < (s32)sizeof(buf) - 1; i++)
+            buf[n++] = sRed[i];
+        for (i = 0; str[i] != 0 && n < (s32)sizeof(buf) - 1; i++)
+            buf[n++] = str[i];
+        buf[n] = 0;
+        str = buf;
+    }
+    PrintStringOnWindow(x, y, str, win, 0);
+}
+
+static void Draw(void)
+{
+    u32 win = sMenu.windowId;
+    s32 i, y;
+
+    CallPrepareTextbox_8008C54(win);
+    sub_80073B8(win);
+
+    if (sMenu.page == PAGE_TOP) {
+        s32 c, skip = CFG.frameSkip < 3 ? CFG.frameSkip : PORT_FRAMESKIP_AUTO;
+        PrintStringOnWindow(16, 0, sTitleTop, win, 0);
+        y = GetMenuEntryYCoord(&sMenu.input, TOP_FRAMESKIP);
+        PrintStringOnWindow(8, y, sFrameSkip, win, 0);
+        for (c = 0; c < 3; c++)
+            PrintStringOnWindow(FRAMESKIP_X(c), y, sSettings[SETTING_FRAMESKIP].choices[c], win, 0);
+        AddDoubleUnderScoreHighlight(win, FRAMESKIP_X(skip), y + 10, GetStringLineWidth(sSettings[SETTING_FRAMESKIP].choices[skip]), COLOR_WHITE_2);
+        y = GetMenuEntryYCoord(&sMenu.input, TOP_DUALCORE);
+        PrintStringOnWindow(8, y, sDualCore, win, 0);
+        PrintStringOnWindow(FRAMESKIP_X(0), y, sOff, win, 0);
+        PrintStringOnWindow(FRAMESKIP_X(1), y, sOn, win, 0);
+        AddDoubleUnderScoreHighlight(win, FRAMESKIP_X(CFG.dualCore ? 1 : 0), y + 10,
+                                     GetStringLineWidth(CFG.dualCore ? sOn : sOff), COLOR_WHITE_2);
+        y = GetMenuEntryYCoord(&sMenu.input, TOP_GPU);
+        PrintStringOnWindow(8, y, sGpuDraw, win, 0);
+        PrintStringOnWindow(FRAMESKIP_X(0), y, sOff, win, 0);
+        PrintStringOnWindow(FRAMESKIP_X(1), y, sOn, win, 0);
+        AddDoubleUnderScoreHighlight(win, FRAMESKIP_X(CFG.gpuDrawOff ? 0 : 1), y + 10,
+                                     GetStringLineWidth(CFG.gpuDrawOff ? sOff : sOn), COLOR_WHITE_2);
+        y = GetMenuEntryYCoord(&sMenu.input, TOP_BUSY);
+        PrintStringOnWindow(8, y, sBusy, win, 0);
+        PrintStringOnWindow(FRAMESKIP_X(0), y, sWait, win, 0);
+        PrintStringOnWindow(FRAMESKIP_X(1), y, sSkip, win, 0);
+        AddDoubleUnderScoreHighlight(win, FRAMESKIP_X(CFG.busyWait ? 0 : 1), y + 10,
+                                     GetStringLineWidth(CFG.busyWait ? sWait : sSkip), COLOR_WHITE_2);
+        y = GetMenuEntryYCoord(&sMenu.input, TOP_MAIN_SCREEN);
+        PrintStringOnWindow(8, y, sMainScreen, win, 0);
+        if (sMenu.deferred ? sMenu.pendingTop : sMenu.options->touchScreen)
+            AddDoubleUnderScoreHighlight(win, 80, y + 10, GetStringLineWidth(sTop), COLOR_WHITE_2);
+        else
+            AddDoubleUnderScoreHighlight(win, 120, y + 10, GetStringLineWidth(sBottom), COLOR_WHITE_2);
+        PrintStringOnWindow(8, GetMenuEntryYCoord(&sMenu.input, TOP_MAIN_SETTINGS), sMainScreenSettings, win, 0);
+        PrintStringOnWindow(8, GetMenuEntryYCoord(&sMenu.input, TOP_SUB_SETTINGS), sSubScreenSettings, win, 0);
+    }
+    else {
+        PrintStringOnWindow(16, 0, sMenu.page == PAGE_MAIN_SCREEN ? sTitleMain : sMenu.page == PAGE_CONTROLS ? sTitleControls
+                                   : sMenu.page == PAGE_MUSIC ? sTitleMusic : sTitleSub, win, 0);
+        for (i = 0; i < EntryCount(); i++) {
+            s32 setting = EntrySetting(i);
+            if (setting == ENTRY_PLAYER) {
+                PrintStringOnWindow(8, GetMenuEntryYCoord(&sMenu.input, i), sMusicPlayer, win, 0);
+                continue;
+            }
+            if (setting == ENTRY_EXTRA_TRACKS) { // (no Explorers of Sky ROM: red)
+                PrintText(8, GetMenuEntryYCoord(&sMenu.input, i), sExtraTracks, win, sMenu.musicLocked || !Port_ExtraMusicOpen());
+                continue;
+            }
+            if (setting < 0) { // a volume: its percent (Left/Right: 10% less/more)
+                u8 text[24];
+                bool8 sfx = setting == ENTRY_SFX_VOLUME, ex = setting == ENTRY_EXTRA_VOLUME;
+                s32 v = (ex ? CFG.extraVolume : sfx ? CFG.sfxVolume : CFG.musicVolume) * 10;
+                y = GetMenuEntryYCoord(&sMenu.input, i);
+                PrintText(8, y, ex ? sExtraVolume : sfx ? sSfxVolume : sMusicVolume, win, sMenu.musicLocked);
+                snprintf((char *)text, sizeof(text), "%d%%", v);
+                PrintText(CHOICE_X(0), y, text, win, sMenu.musicLocked);
+                continue;
+            }
+            s32 c, value = *SettingValue(setting), first = FirstChoice(setting);
+            if (value >= sSettings[setting].count || value < first)
+                value = first;
+            y = GetMenuEntryYCoord(&sMenu.input, i);
+            PrintText(8, y, sSettings[setting].name, win, IsPlaceholder(setting, -1));
+            for (c = first; c < sSettings[setting].count; c++)
+                PrintText(CHOICE_X(c - first), y, sSettings[setting].choices[c], win, IsPlaceholder(setting, c));
+            AddDoubleUnderScoreHighlight(win, CHOICE_X(value - first), y + 10, GetStringLineWidth(sSettings[setting].choices[value]), COLOR_WHITE_2);
+        }
+    }
+
+    sub_80073E0(win);
+}
+
+// Shows the window for the current page, with the cursor on `entry`.
+static void ShowPage(s32 entry)
+{
+    s32 count = EntryCount();
+
+    RestoreSavedWindows(&sMenu.windows);
+    sMenu.windows.id[sMenu.windowId] = sWindow;
+    sub_8012D08(&sMenu.windows.id[sMenu.windowId], count);
+    ResetUnusedInputStruct();
+    ShowWindows(&sMenu.windows, TRUE, TRUE);
+    CreateMenuOnWindow(&sMenu.input, count, count, sMenu.windowId);
+    MoveMenuToEntryId(&sMenu.input, entry);
+    Draw();
+}
+
+void PortScreenMenu_Create(GameOptions *options, bool8 deferred)
+{
+    sMenu.options = options;
+    sMenu.windowId = 0;
+    sMenu.page = PAGE_TOP;
+    if (gPortConfig.layout[1][0] < PORT_SIZE_DS) // the second screen is DS-sized
+        gPortConfig.layout[1][0] = PORT_SIZE_DS;
+    sMenu.startConfig = gPortConfig;
+    sMenu.deferred = deferred;
+    sMenu.pending = gPortConfig;
+    sMenu.pendingTop = options->touchScreen;
+    sMenu.cfg = deferred ? &sMenu.pending : &gPortConfig;
+    ShowPage(0);
+}
+
+// Deferred: the changed settings written (the config file; the game options,
+// Main Screen, in the save) without taking effect yet
+void PortScreenMenu_SavePending(void)
+{
+    struct PortConfig live = gPortConfig;
+    u8 liveTop = gGameOptionsRef->touchScreen;
+    gPortConfig = sMenu.pending;
+    Port_SaveConfig();
+    if (sMenu.pendingTop != liveTop) {
+        gGameOptionsRef->touchScreen = sMenu.pendingTop;
+        Port_WriteGameOptionsToPak();
+    }
+    gPortConfig = live;
+    gGameOptionsRef->touchScreen = liveTop;
+}
+
+// ... and then made the ones in effect (the screen black: main_loops.c)
+void PortScreenMenu_Commit(void)
+{
+    gPortConfig = sMenu.pending;
+    gGameOptionsRef->touchScreen = sMenu.pendingTop;
+    sMenu.deferred = FALSE;
+    sMenu.cfg = &gPortConfig;
+    Port_UpdateScreenSize();
+}
+
+// Others > Controls Options: the same window, with only its page
+void PortControlMenu_Create(GameOptions *options)
+{
+    sMenu.options = options;
+    sMenu.windowId = 0;
+    sMenu.page = PAGE_CONTROLS;
+    sMenu.startConfig = gPortConfig;
+    sMenu.deferred = FALSE;
+    sMenu.cfg = &gPortConfig;
+    ShowPage(0);
+}
+
+// Game Options > Music Options (on the title): Music Style, Sound Effects,
+// Music Volume, SFX Volume, and Music Player.
+// locked: pmd-blue.nds is another game's: GBA music, and the cursor can't go
+// to Music Style.
+void PortMusicMenu_Create(GameOptions *options, bool8 locked, s32 entry)
+{
+    sMenu.options = options;
+    sMenu.windowId = 0;
+    sMenu.page = PAGE_MUSIC;
+    sMenu.musicLocked = locked;
+    if (locked) {
+        gPortConfig.musicStyle = PORT_MUSIC_GBA;
+        gPortConfig.sfxStyle = PORT_MUSIC_GBA;
+        entry = MUSIC_PLAYER;
+    }
+    sMenu.startConfig = gPortConfig;
+    sMenu.deferred = FALSE;
+    sMenu.cfg = &gPortConfig;
+    ShowPage(entry);
+}
+
+// Whether the port settings changed since the menu was opened.
+bool8 PortScreenMenu_Changed(void)
+{
+    if (sMenu.deferred)
+        return memcmp(&sMenu.startConfig, &sMenu.pending, sizeof(gPortConfig)) != 0
+            || sMenu.pendingTop != gGameOptionsRef->touchScreen;
+    return memcmp(&sMenu.startConfig, &gPortConfig, sizeof(gPortConfig)) != 0;
+}
+
+// 0: still open; 1: redrawn; 2: closed with B; 3: closed with A; 4: Extra Music
+// turned on without its ROM (to be found; still open, unchanged); 5: A on Extra
+// Music Volumes (closed).
+u32 PortScreenMenu_Update(void)
+{
+    bool8 changed = FALSE;
+    s32 index = sMenu.input.menuIndex;
+
+    s32 input = GetMenuInput();
+
+    switch (input) {
+        case INPUT_B_BUTTON:
+        case INPUT_A_BUTTON: {
+            bool8 accept = input == INPUT_A_BUTTON;
+            if (sMenu.page == PAGE_CONTROLS) { // its own menu: closed
+                PlayMenuSoundEffect(accept ? MENU_SFX_ACCEPT : MENU_SFX_BACK);
+                return accept ? 3 : 2;
+            }
+            if (sMenu.page == PAGE_MUSIC) { // A on Music Player opens it
+                if (accept && index == MUSIC_EXTRA_TRACKS && !sMenu.musicLocked) { // ... and its songs' volumes
+                    if (!Port_ExtraMusicOpen()) {
+                        PlayMenuSoundEffect(MENU_SFX_FAIL);
+                        break;
+                    }
+                    PlayMenuSoundEffect(MENU_SFX_ACCEPT);
+                    return 5;
+                }
+                if (accept && index != MUSIC_PLAYER)
+                    break;
+                PlayMenuSoundEffect(accept ? MENU_SFX_ACCEPT : MENU_SFX_BACK);
+                return accept ? 3 : 2;
+            }
+            if (sMenu.page != PAGE_TOP) {
+                // back to the first page, on the entry that led here
+                PlayMenuSoundEffect(accept ? MENU_SFX_ACCEPT : MENU_SFX_BACK);
+                index = sMenu.page == PAGE_MAIN_SCREEN ? TOP_MAIN_SETTINGS : TOP_SUB_SETTINGS;
+                sMenu.page = PAGE_TOP;
+                ShowPage(index);
+                return 1;
+            }
+            if (accept && (index == TOP_MAIN_SETTINGS || index == TOP_SUB_SETTINGS)) {
+                PlayMenuSoundEffect(MENU_SFX_ACCEPT);
+                sMenu.page = index == TOP_MAIN_SETTINGS ? PAGE_MAIN_SCREEN : PAGE_SUB_SCREEN;
+                ShowPage(0);
+                return 1;
+            }
+            PlayMenuSoundEffect(accept ? MENU_SFX_ACCEPT : MENU_SFX_BACK);
+            return accept ? 3 : 2;
+        }
+        case INPUT_DPAD_LEFT:
+        case INPUT_DPAD_RIGHT: {
+            s32 step = input == INPUT_DPAD_LEFT ? -1 : 1;
+            if (sMenu.page == PAGE_TOP) {
+                if (index == TOP_FRAMESKIP) {
+                    s32 v = CFG.frameSkip < 3 ? CFG.frameSkip : PORT_FRAMESKIP_AUTO;
+                    CFG.frameSkip = (u8)((v + 3 + step) % 3);
+                    changed = TRUE;
+                }
+                else if (index == TOP_GPU) {
+                    CFG.gpuDrawOff = !CFG.gpuDrawOff;
+                    changed = TRUE;
+                }
+                else if (index == TOP_BUSY) {
+                    CFG.busyWait = !CFG.busyWait;
+                    changed = TRUE;
+                }
+                else if (index == TOP_DUALCORE) {
+                    CFG.dualCore = !CFG.dualCore;
+                    changed = TRUE;
+                }
+                else if (index == TOP_MAIN_SCREEN) {
+                    if (sMenu.deferred)
+                        sMenu.pendingTop = !sMenu.pendingTop;
+                    else
+                        sMenu.options->touchScreen = !sMenu.options->touchScreen;
+                    changed = TRUE;
+                }
+            }
+            else if (sMenu.page == PAGE_MUSIC && (index == MUSIC_PLAYER || index == MUSIC_EXTRA_TRACKS || sMenu.musicLocked)) {
+                // (Music Player has no choices; a locked Music Style stays GBA)
+            }
+            else if (sMenu.page == PAGE_MUSIC && (index == MUSIC_VOLUME || index == MUSIC_SFX_VOLUME || index == MUSIC_EXTRA_VOLUME)) {
+                // 10% a press (heard at once: the DS music, and this menu's own sounds)
+                u8 *v = index == MUSIC_VOLUME ? &CFG.musicVolume : index == MUSIC_EXTRA_VOLUME ? &CFG.extraVolume : &CFG.sfxVolume;
+                s32 n = *v + step;
+                if (n >= VOLUME_MIN && n <= VOLUME_MAX) {
+                    *v = (u8)n;
+                    changed = TRUE;
+                }
+            }
+            else if (sMenu.page == PAGE_MUSIC && index == MUSIC_EXTRA && !CFG.extraMusic && !Port_ExtraMusicOpen()) {
+                // On, without Explorers of Sky's ROM: found first (options_menu1.c)
+                PlayMenuSoundEffect(MENU_SFX_ACCEPT);
+                return 4;
+            }
+            else {
+                s32 setting = EntrySetting(index);
+                s32 first = FirstChoice(setting);
+                s32 n = sSettings[setting].count - first;
+                u8 *value = SettingValue(setting);
+                s32 v = *value < first || *value >= sSettings[setting].count ? 0 : *value - first;
+                *value = (u8)(first + (v + n + step) % n);
+                if (!sMenu.deferred)
+                    Port_UpdateScreenSize();
+                changed = TRUE;
+            }
+            if (changed)
+                PlayMenuSoundEffect(MENU_SFX_NAVIGATE);
+            break;
+        }
+    }
+
+    // A locked Music Style: the cursor stays on Music Player
+    if (MenuCursorUpdate(&sMenu.input, !(sMenu.page == PAGE_MUSIC && sMenu.musicLocked)) || changed) {
+        Draw();
+        return 1;
+    }
+    return 0;
+}
+
+void PortScreenMenu_Destroy(void)
+{
+    sMenu.windows.id[sMenu.windowId] = sNoWindow;
+    ResetUnusedInputStruct();
+    ShowWindows(&sMenu.windows, TRUE, TRUE);
+}
+
+#endif // PLATFORM_3DS
diff --git a/src/port_shiny.c b/src/port_shiny.c
new file mode 100644
index 00000000..91e5cb2b
--- /dev/null
+++ b/src/port_shiny.c
@@ -0,0 +1,202 @@
+// 3DS port, run option Shiny Pokémon: shiny Pokémon's colors in dungeons.
+//
+// Red's species share 13 sprite palettes (OBJ palettes 0-12, "palet"); the
+// GBA has no spare ones. A shiny instead borrows one of those 13 that no other
+// Pokémon on the floor needs (no monster there, and no species of the floor's
+// spawn list), loaded with its species' shiny colors (data/port_shiny_palettes.h,
+// made by tools/shiny_palettes.py), and is drawn with it. With none to spare,
+// it keeps its normal colors until one is. Which Pokémon are shiny:
+// EntityInfo.shiny (dungeon_mon_spawn.c rolls it, port_new_run.h).
+#include "global.h"
+#include "globaldata.h"
+#include "bg_palette_buffer.h"
+#include "constants/monster.h"
+#include "dungeon_util.h"
+#include "dungeon_vram.h"
+#include "pokemon.h"
+#include "items.h"
+#include "port_new_run.h"
+#include "structs/rgb.h"
+#include "structs/str_dungeon.h"
+
+#ifdef PLATFORM_3DS
+
+#include "data/port_shiny_palettes.h"
+
+#define MON_PALETTES 13 // (OBJ palettes 0-12)
+
+static struct {
+    s32 frame;                    // the dungeon frame the slots were last chosen in
+    s16 species[MON_PALETTES];    // the shiny species each palette holds (0: its own)
+} sShiny = { -1 };
+
+static bool8 HasShinyPalette(s32 species)
+{
+    if (species <= 0 || species >= (s32)ARRAY_COUNT(sPortShinyPalettes))
+        return FALSE;
+    return sPortShinyPalettes[species][1][0] | sPortShinyPalettes[species][1][1] | sPortShinyPalettes[species][1][2]
+        | sPortShinyPalettes[species][2][0] | sPortShinyPalettes[species][2][1] | sPortShinyPalettes[species][2][2];
+}
+
+// A species' shiny sprite colors (16, r g b), or NULL (none)
+const u8 (*PortShiny_SpeciesPalette(s32 species))[3]
+{
+    return HasShinyPalette(species) ? sPortShinyPalettes[species] : NULL;
+}
+
+static void UploadSlot(s32 slot)
+{
+    s32 i;
+    const u8 (*pal)[3] = sPortShinyPalettes[sShiny.species[slot]];
+
+    for (i = 0; i < 16; i++) {
+        RGB_Struct c = { pal[i][0], pal[i][1], pal[i][2], 0x80 };
+        SetBGPaletteBufferColorRGB(256 + slot * 16 + i, &c, gDungeonBrightness, gDungeon->colorRamp);
+    }
+}
+
+// The game loaded the 13 palettes again (sub_803E874: a new floor, a fade...)
+void PortShiny_DungeonPalettesLoaded(void)
+{
+    s32 slot;
+
+    if (sShiny.frame != gDungeonFramesCounter) {
+        // (not chosen this frame, maybe for another floor: all 13 are their
+        // own colors now, and the next draw chooses again)
+        memset(sShiny.species, 0, sizeof(sShiny.species));
+        return;
+    }
+    for (slot = 0; slot < MON_PALETTES; slot++)
+        if (sShiny.species[slot] != 0)
+            UploadSlot(slot);
+}
+
+static void ChooseSlots(void)
+{
+    bool8 needed[MON_PALETTES] = {0};
+    s16 shinies[DUNGEON_MAX_POKEMON];
+    s32 numShinies = 0;
+    s32 i, j, slot;
+    s16 old[MON_PALETTES];
+
+    memcpy(old, sShiny.species, sizeof(old));
+    // The palettes others need: every monster on the floor that isn't shiny
+    // (or has no shiny colors), any the floor may still spawn, every item on
+    // the floor's (items share these palettes), and those the game picks by
+    // itself (Kecleon's shop colors, the Decoy; palette 10, items seen while
+    // hallucinating).
+    for (i = 0; i < DUNGEON_MAX_POKEMON; i++) {
+        Entity *e = gDungeon->activePokemon[i];
+        EntityInfo *info;
+        s32 species;
+
+        if (!EntityIsValid(e))
+            continue;
+        info = GetEntInfo(e);
+        species = info->apparentID;
+        if (info->shiny && HasShinyPalette(species)) {
+            for (j = 0; j < numShinies && shinies[j] != species; j++)
+                ;
+            if (j == numShinies)
+                shinies[numShinies++] = species;
+        }
+        else {
+            needed[GetPokemonOverworldPalette(species, FALSE) % MON_PALETTES] = TRUE;
+        }
+    }
+    for (i = 0; i < MONSTER_SPAWNS_ARR_COUNT; i++) {
+        s32 species = gDungeon->monsterSpawns[i].bits & PACKED_BITS_SPECIES;
+        if (species != MONSTER_NONE)
+            needed[GetPokemonOverworldPalette(species, FALSE) % MON_PALETTES] = TRUE;
+    }
+    for (i = 0; i < MAX_TEAM_MEMBERS; i++) {
+        DungeonMon *m = &gRecruitedPokemonRef->dungeonTeam[i];
+        if ((m->flags & POKEMON_FLAG_EXISTS) && !m->shiny)
+            needed[GetPokemonOverworldPalette(m->speciesNum, FALSE) % MON_PALETTES] = TRUE;
+    }
+    for (i = 0; i < DUNGEON_MAX_ITEMS; i++) {
+        Entity *e = gDungeon->items[i];
+        if (EntityIsValid(e))
+            needed[GetItemPalette(GetItemInfo(e)->id) % MON_PALETTES] = TRUE;
+    }
+    if (gDungeon->unk181e8.hallucinating)
+        needed[10] = TRUE;
+    needed[GetPokemonOverworldPalette(MONSTER_KECLEON, TRUE)] = TRUE;
+    needed[GetPokemonOverworldPalette(MONSTER_DECOY, FALSE) % MON_PALETTES] = TRUE;
+
+    // Shinies keep the palette they had while it's still free
+    for (slot = 0; slot < MON_PALETTES; slot++) {
+        s32 keep = FALSE;
+        if (sShiny.species[slot] != 0 && !needed[slot]) {
+            for (j = 0; j < numShinies; j++) {
+                if (shinies[j] == sShiny.species[slot]) {
+                    shinies[j] = 0; // (placed)
+                    keep = TRUE;
+                    break;
+                }
+            }
+        }
+        if (!keep)
+            sShiny.species[slot] = 0;
+    }
+    for (j = 0; j < numShinies; j++) {
+        if (shinies[j] == 0)
+            continue;
+        for (slot = MON_PALETTES - 1; slot >= 0; slot--) {
+            if (!needed[slot] && sShiny.species[slot] == 0) {
+                sShiny.species[slot] = shinies[j];
+                break;
+            }
+        }
+    }
+    for (slot = 0; slot < MON_PALETTES; slot++) {
+        if (sShiny.species[slot] != old[slot]) {
+            if (sShiny.species[slot] != 0)
+                UploadSlot(slot);
+            else if (old[slot] != 0) {
+                // (back to its own colors)
+                const RGB_Struct *color = ((const RGB_Struct *)gDungeon->paletFile->data) + slot * 16;
+                for (i = 0; i < 16; i++)
+                    SetBGPaletteBufferColorRGB(256 + slot * 16 + i, &color[i], gDungeonBrightness, gDungeon->colorRamp);
+            }
+        }
+    }
+}
+
+// The palette to draw a dungeon monster with (dungeon_mon_sprite_render.c):
+// its shiny one's slot if it's shiny and has one, else `normal`. Called for
+// every monster drawn.
+s32 PortShiny_DungeonPalette(EntityInfo *info, s32 normal)
+{
+    s32 slot;
+
+    // (every frame a monster is drawn, shiny or not: a palette a shiny no
+    // longer needs gets its own colors back)
+    if (sShiny.frame != gDungeonFramesCounter) {
+        sShiny.frame = gDungeonFramesCounter;
+        ChooseSlots();
+    }
+    if (!info->shiny)
+        return normal;
+    for (slot = 0; slot < MON_PALETTES; slot++)
+        if (sShiny.species[slot] == info->apparentID)
+            return slot;
+    return normal;
+}
+
+// The colors of OBJ palette `slot` if it holds a shiny species' (the
+// sub-screen's team panel: "palet" has the slot's own), as r g b 0-31
+bool8 PortShiny_SlotColors(s32 slot, u16 *out)
+{
+    s32 i;
+    const u8 (*pal)[3];
+
+    if (slot < 0 || slot >= MON_PALETTES || sShiny.species[slot] == 0)
+        return FALSE;
+    pal = sPortShinyPalettes[sShiny.species[slot]];
+    for (i = 0; i < 16; i++)
+        out[i] = (pal[i][0] >> 3) | ((pal[i][1] >> 3) << 5) | ((pal[i][2] >> 3) << 10);
+    return TRUE;
+}
+
+#endif // PLATFORM_3DS
