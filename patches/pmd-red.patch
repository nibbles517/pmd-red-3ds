+        ;
+    else if (e->applyFadeToRow == BlendRowPalette || e->applyFadeToSingle == BlendSinglePalette) {
+        out->mul = amount;
+        out->add[0] = (u8)(e->fadeColor.c[RGB_R] * (MAX_FADE_AMOUNT - amount) / 256);
+        out->add[1] = (u8)(e->fadeColor.c[RGB_G] * (MAX_FADE_AMOUNT - amount) / 256);
+        out->add[2] = (u8)(e->fadeColor.c[RGB_B] * (MAX_FADE_AMOUNT - amount) / 256);
+        return out;
+    }
+    else
+        return NULL;
+    out->mul = amount;
+    out->add[0] = out->add[1] = out->add[2] = 0;
