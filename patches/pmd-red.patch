+void Port_ShowWideMapArrays(s32 bgX, s32 bgY)
+{
+    s32 bg;
+    for (bg = 2; bg <= 3; bg++) {
+        gPortWideBg[bg].map = sPortWideMaps[bg - 2];
+        gPortWideBg[bg].scrollX = bgX;
+        gPortWideBg[bg].scrollY = bgY;
+    }
+    gPortWideView = 2;
+    gPortHudLines = 0;
