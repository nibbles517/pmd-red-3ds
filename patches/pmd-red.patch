+extern GroundBg *gUnknown_3001B78; // ground_weather.c
+
+static void Port_RenderWideLayers(MapRender *mapRender)
+{
+    s32 j;
+    s32 cd = mapRender->chunkDimensions == CHUNK_DIMENSIONS_2x2 ? 2
+           : mapRender->chunkDimensions == CHUNK_DIMENSIONS_3x3 ? 3 : 0;
+    s32 mapW = mapRender->mapSizePixels.x / 8, mapH = mapRender->mapSizePixels.y / 8;
+    s32 tx0 = (mapRender->cameraPos.x - WIDE_OX) >> 3, ty0 = mapRender->cameraPos.y >> 3;
+
+    bool8 overlay;
+
+    if (gPortGroundNarrow || !PORT_WIDE_SIZE)
+        return;
+    overlay = gUnknown_3001B78 != NULL && (u8 *)mapRender >= (u8 *)gUnknown_3001B78 && (u8 *)mapRender < (u8 *)(gUnknown_3001B78 + 1);
+    for (j = 0; j < mapRender->numBgs; j++) {
+        u16 *tilemap = mapRender->bgTilemaps[j];
+        const u16 *chunks = mapRender->chunkMappings[j];
+        s32 bg, tx, ty;
+        u16 *dst;
+
+        if (tilemap == NULL)
+            continue;
+        bg = (tilemap - &gBgTilemaps[0][0][0]) / (32 * 32);
+        if (bg < 2 || bg > 3)
+            continue;
+        dst = sPortWideMaps[bg - 2];
+        if (cd == 0 || chunks == NULL) {
+            for (ty = ty0; ty < ty0 + SCREEN_H / 8 + 1; ty++)
+                for (tx = tx0; tx < tx0 + SCREEN_W / 8 + 1; tx++)
+                    dst[(ty & 63) * 64 + (tx & 63)] = 0;
+        }
+        else {
+            // Each column's chunk and place in it, worked out once (no
+            // divisions in the loop: this runs every frame).
+            s16 colChunk[SCREEN_W_MAX / 8 + 1], colIn[SCREEN_W_MAX / 8 + 1];
+            for (tx = tx0; tx < tx0 + SCREEN_W / 8 + 1; tx++) {
+                s32 mx = tx, i = tx - tx0;
+                if (mapRender->wrapAround || overlay)
+                    mx = ((mx % mapW) + mapW) % mapW;
+                if (mx < 0 || mx >= mapW) {
+                    colChunk[i] = -1;
+                    colIn[i] = 0;
+                } else {
+                    colChunk[i] = mx / cd;
+                    colIn[i] = mx % cd;
+                }
+            }
+            for (ty = ty0; ty < ty0 + SCREEN_H / 8 + 1; ty++) {
+                s32 my = ty;
+                u16 *out = &dst[(ty & 63) * 64];
+                const u16 *chunkRow;
+                const u16 *tiles;
+                if (mapRender->wrapAround)
+                    my = ((my % mapH) + mapH) % mapH;
+                if (my < 0 || my >= mapH) {
+                    for (tx = tx0; tx < tx0 + SCREEN_W / 8 + 1; tx++)
+                        out[tx & 63] = overlay ? 0 : PORT_WIDE_BLACK;
+                    continue;
+                }
+                chunkRow = &chunks[(my / cd) * 64];
+                tiles = &mapRender->tileMappings[(my % cd) * cd];
+                for (tx = tx0; tx < tx0 + SCREEN_W / 8 + 1; tx++) {
+                    s32 i = tx - tx0;
+                    out[tx & 63] = colChunk[i] < 0 ? PORT_WIDE_BLACK : tiles[chunkRow[colChunk[i]] * 9 + colIn[i]];
+                }
+            }
+        }
+        gPortWideBg[bg].map = dst;
+        gPortWideBg[bg].scrollX = mapRender->cameraPos.x;
+        gPortWideBg[bg].scrollY = mapRender->cameraPos.y;
+    }
