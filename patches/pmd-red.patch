+
+static s32 RomLower(s32 c) { return c >= 'A' && c <= 'Z' ? c + 32 : c; }
+
+static bool8 RomIsNds(const char *name)
+{
+    size_t n = strlen(name);
+    return n > 4 && name[n - 4] == '.' && RomLower(name[n - 3]) == 'n' && RomLower(name[n - 2]) == 'd'
+        && RomLower(name[n - 1]) == 's';
+}
+
+static s32 RomCompare(const PortDirEntry *a, const PortDirEntry *b)
+{
+    const char *x = a->name, *y = b->name;
+    if (a->isDir != b->isDir)
+        return a->isDir ? -1 : 1;
+    while (*x && RomLower(*x) == RomLower(*y)) { x++; y++; }
+    return RomLower((u8)*x) - RomLower((u8)*y);
+}
+
+// sRomDir's folders and .nds files (not hidden ones), sorted
+static void RomReadDir(void)
+{
+    s32 i, j, n = Backend_DirList(sRomDir, sRomEntries, ROM_MAX);
+
+    sRomStatus = n < 0 ? sRomCantRead : NULL;
+    sRomCount = 0;
+    for (i = 0; i < n; i++) {
+        if (sRomEntries[i].name[0] == '.' || (!sRomEntries[i].isDir && !RomIsNds(sRomEntries[i].name)))
+            continue;
+        sRomEntries[sRomCount++] = sRomEntries[i];
+    }
+    for (i = 1; i < sRomCount; i++) { // (insertion sort: a few hundred at most)
+        PortDirEntry e = sRomEntries[i];
+        for (j = i; j > 0 && RomCompare(&sRomEntries[j - 1], &e) > 0; j--)
+            sRomEntries[j] = sRomEntries[j - 1];
+        sRomEntries[j] = e;
+    }
+}
+
+static void RomPath(char *out, s32 size, const char *name)
+{
+    snprintf(out, size, "%s%s%s", sRomDir, sRomDir[strlen(sRomDir) - 1] == '/' ? "" : "/", name);
+}
