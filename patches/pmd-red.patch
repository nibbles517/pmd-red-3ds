+static void HandleMatchMenu(void)
+{
+    u16 keys = Port_KeysHeld();
+    u16 pressed = keys & ~sMusicPrevKeys;
+    s32 song = GET_CURRENT_MENU_ENTRY(sMatchInput);
+    s32 step = 0;
+    bool8 redraw = FALSE;
+
+    sMusicPrevKeys = keys;
+    // The DS side's volume (the sound effects' or the music's): Circle Pad up/down
+    if (!sMatchSfx && MusicVolumeKeys(keys, PORT_KEY_CPAD_UP, PORT_KEY_CPAD_DOWN, FALSE))
+        redraw = TRUE;
+    if (sMatchSfx && MatchSfxKeys(keys, pressed, song)) {
+        DrawMatchList();
+        DrawMatchInfo();
+        return;
+    }
+    if (gRealInputs.pressed & L_BUTTON)
+        step = -1;
+    else if (gRealInputs.pressed & R_BUTTON)
+        step = 1;
+    else if (pressed & PORT_KEY_ZL)
+        step = -10;
+    else if (pressed & PORT_KEY_ZR)
+        step = 10;
+
+    if (step != 0) { // another DS track (or sound effect) for this one, played at once
+        // (music: the tracks before the sound effects; sound effects: those after)
+        s32 first = sMatchSfx ? Port_MusicSongCount() : 0, last = sMatchSfx ? Port_MusicCount() - 1 : Port_MusicSongCount() - 1;
+        s32 track = MatchGet(song);
+        track = track < 0 ? (step > 0 ? first + step - 1 : last + 1 + step) : track + step;
+        if (track < first)
+            track = first;
+        if (track > last)
+            track = last;
+        MatchSet(song, track);
+        PlayMatchDs(song);
+        sMatchStatus = NULL;
+        redraw = TRUE;
+    }
+    else if (gRealInputs.pressed & START_BUTTON) {
+        sMatchStatus = SaveMatches() ? (sMatchSfx ? sSfxMatchSaved : sMatchSaved) : (sMatchSfx ? sSfxMatchNotSaved : sMatchNotSaved);
+        PlayMenuSoundEffect(MENU_SFX_ACCEPT);
+        redraw = TRUE;
+    }
+    else if (pressed & PORT_KEY_X) {
+        MatchSet(song, -1);
+        Port_MusicStop();
+        sMatchStatus = NULL;
+        redraw = TRUE;
+    }
+    else if (pressed & PORT_KEY_Y) {
+        PlayMatchDs(song);
+        sMatchStatus = NULL;
+        redraw = TRUE;
+    }
+    else {
+        switch (GetKeyPress(&sMatchInput)) {
+            case INPUT_B_BUTTON:
+                PlayMenuSoundEffect(MENU_SFX_BACK);
+                SaveMatches();
+                if (sMatchVolumes[0] != gPortConfig.musicVolume || sMatchVolumes[1] != gPortConfig.sfxVolume)
+                    Port_SaveConfig();
+                if (sMatchSfx)
+                    sMatchCursorSfx = song;
+                else
+                    sMatchCursor = song;
+                gPortMatchBgm = -1;
+                Port_MusicClose();
+                StopBGM();
+                StopFanfareSE(STOP_FANFARE);
+                StopFanfareSE(STOP_SOUND_EFFECT);
+                gPortDsMusicOff = FALSE;
+                gPortRawXY = FALSE;
+                Port_DsMusicRecheck();
+                StartNewBGM(MUS_FILE_SELECT); // the title's music again
+                SetOptionsMenuState(OPTIONS_MENU_MAIN);
+                return;
+            case INPUT_A_BUTTON:
+                PlayMatchGba(song);
+                sMatchStatus = NULL;
+                redraw = TRUE;
+                break;
+            default: {
+                s32 before = GET_CURRENT_MENU_ENTRY(sMatchInput);
+                if (MenuCursorUpdate(&sMatchInput, TRUE))
+                    redraw = TRUE;
+                if (GET_CURRENT_MENU_ENTRY(sMatchInput) != before) {
+                    sMatchStatus = NULL;
+                    DrawMatchInfo();
+                }
+                break;
+            }
+        }
+    }
+    if (redraw) {
+        DrawMatchList();
+        DrawMatchInfo();
+    }
+}
