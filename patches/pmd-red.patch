+void Port_PalFadeContext(const PortPalFade *fade); // (bg_palette_buffer.c)
+
+static const PortPalFade *PortFadeOf(const PaletteFadeEntry *e, PortPalFade *out)
+{
+    u16 amount = e->fadeAmount >= MAX_FADE_AMOUNT ? MAX_FADE_AMOUNT : e->fadeAmount;
+    if (e->applyFadeToRow == ApplyRowPalette || e->applyFadeToSingle == ApplySinglePalette)
