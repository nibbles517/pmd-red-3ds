+            // Run option 3: a Max Elixir is a vitamin 1 time in 100: Protein,
+            // Iron, Calcium or Zinc, as likely each
+            if (i == ITEM_MAX_ELIXIR && gPortRunOptions[PORT_RUN_ELIXIR_TO_VITAMIN] && DungeonRandInt(100) == 0) {
+                static const u8 sVitamins[4] = { ITEM_PROTEIN, ITEM_IRON, ITEM_CALCIUM, ITEM_ZINC };
+                return sVitamins[DungeonRandInt(4)];
+            }
+#endif
             return i;
         }
     }
