+        if (spriteInfo.gfxIndex == STATUS_GFX_NONE)
+            continue;
+        gfxInfo = &sStatusGfxInfo[spriteInfo.gfxIndex];
+        size = gfxInfo->width * gfxInfo->height * 32;
+        out[n].gfx = sStatusGfx + gfxInfo->offsetIntoGraphic + ((sDungeonPokemonSprites->frame / 4) % gfxInfo->graphicsCount) * size;
+        out[n].width = gfxInfo->width;
+        out[n].height = gfxInfo->height;
+        out[n].palNum = spriteInfo.palIndex;
+        out[n].anchor = i == 0 ? 0 : 3;
+        out[n].dx = -gfxInfo->width * 4 + (spriteInfo.gfxIndex == STATUS_GFX_SLEEP ? 8 : 0);
+        out[n].dy = -gfxInfo->height * 4 - (spriteInfo.gfxIndex == STATUS_GFX_FROZEN ? 0 : 16);
+        n++;
+    }
+    return n;
+}
