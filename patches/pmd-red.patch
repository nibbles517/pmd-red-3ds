+// Windows Options / Layout Options / Graphics Options (and its two pages):
+// like ShowOthersOptions.
+static bool8 ShowPortOptions(s32 page)
+{
+    bool8 redraw;
+    bool8 bPress = FALSE;
+    s32 entry = 0;
+
+    while (TRUE) {
+        bPress = FALSE;
+        redraw = FALSE;
+        sPortPage = page;
+        gDungeonMenu.menuIndex = entry;
+
+        PrintPortPage();
+        gDungeonMenu.menuIndex = entry;
+        while (TRUE) {
+            AddMenuCursorSprite(&gDungeonMenu);
+            DungeonRunFrameActions(0x24);
+            if (gRealInputs.repeated & DPAD_DOWN) {
+                PlayDungeonCursorSE(TRUE);
+                MoveMenuCursorDownWrapAround(&gDungeonMenu, TRUE);
+            }
+            if (gRealInputs.repeated & DPAD_UP) {
+                PlayDungeonCursorSE(TRUE);
+                MoveMenuCursorUpWrapAround(&gDungeonMenu, TRUE);
+            }
+            if ((gRealInputs.repeated & DPAD_LEFT) && PortChangeValue(gDungeonMenu.menuIndex, -1)) {
+                PlayDungeonCursorSE(FALSE);
+                PortApplyNow();
+                redraw = TRUE;
+                break;
+            }
+            if ((gRealInputs.repeated & DPAD_RIGHT) && PortChangeValue(gDungeonMenu.menuIndex, 1)) {
+                PlayDungeonCursorSE(FALSE);
+                PortApplyNow();
+                redraw = TRUE;
+                break;
+            }
+            if ((gRealInputs.pressed & A_BUTTON) || gDungeonMenu.touchScreen.b_button) {
+                PlayDungeonConfirmationSE();
+                if (sPortRows[page][gDungeonMenu.menuIndex].link != NO_LINK) {
+                    // a page of its own; back here afterwards, on this row
+                    entry = gDungeonMenu.menuIndex;
+                    AddMenuCursorSprite(&gDungeonMenu);
+                    DungeonRunFrameActions(0x24);
+                    ShowPortOptions(sPortRows[page][entry].link);
+                    redraw = TRUE;
+                }
+                break;
+            }
+            if (gRealInputs.pressed & B_BUTTON) {
+                PlayDungeonCancelSE();
+                bPress = TRUE;
+                break;
+            }
+        }
+
+        if (sPortPage == page)
+            entry = gDungeonMenu.menuIndex;
+        AddMenuCursorSprite(&gDungeonMenu);
+        DungeonRunFrameActions(0x24);
+        if (!redraw)
+            break;
+    }
+
+    return bPress;
+}
