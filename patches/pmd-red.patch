diff --git a/src/port_screen_menu.c b/src/port_screen_menu.c
new file mode 100644
index 00000000..8402baa6
--- /dev/null
+++ b/src/port_screen_menu.c
@@ -0,0 +1,242 @@
+// 3DS port: Others > Screen Options (outside dungeons).
+//
+// Built like the game's own Game Options window (options_menu2.c):
+//   Main Screen            Top / Bottom (kept in the save's game options, in the
+//                          bit the DS version uses for its touch screen option:
+//                          clear = bottom, set = top)
+//   Main Screen Settings   a page of two toggles, Size (GBA/DS/3DS) and
+//                          Scale (None/Full/Stretch), placeholders for now
+//   Sub-Screen Settings    Enabled? (Yes/No: turns the second screen on/off),
+//                          then the same Size and Scale placeholders
+// The page settings live in the port's own config file (gPortConfig). Every
+// toggle takes effect as soon as it changes; the file is written when the
+// menu is left (options_menu1.c, "Changes saved.").
+#include <string.h>
+#include "global.h"
+#include "globaldata.h"
+#include "constants/colors.h"
+#include "constants/input.h"
+#include "music_util.h"
+#include "input.h"
+#include "menu_input.h"
+#include "port_screen_menu.h"
+#include "port_game.h"
+#include "text_1.h"
+#include "text_2.h"
+#include "text_3.h"
+
+#ifdef PLATFORM_3DS
+
+enum { PAGE_TOP, PAGE_MAIN_SCREEN, PAGE_SUB_SCREEN };
+
+#define TOP_ENTRIES 3
+#define MAX_CHOICES 3
+
+enum { SETTING_ENABLED, SETTING_SIZE, SETTING_SCALE };
+
+static struct {
+    GameOptions *options;
+    MenuInputStruct input;
+    u32 windowId;
+    WindowTemplates windows;
+    s32 page;
+    struct PortConfig startConfig; // the settings when the menu was opened
+} sMenu;
+
+static const WindowTemplate sNoWindow = { 0, 3, 0, 0, 0, 0, 0, 0, NULL };
+static const WindowHeader sHeader = { 1, 0, 15, 0 };
+static const WindowTemplate sWindow = {
+    0,
+    6,
+    2, 2,
+    24, 16,
+    18, 0,
+    &sHeader
+};
+
+ALIGNED(4) static const u8 sTitleTop[] = _("Screen Options");
+ALIGNED(4) static const u8 sTitleMain[] = _("Main Screen Settings");
+ALIGNED(4) static const u8 sTitleSub[] = _("Sub-Screen Settings");
+ALIGNED(4) static const u8 sMainScreen[] = _("Main Screen{MOVE_X_POSITION_BY_80}Top{MOVE_X_POSITION_BY_120}Bottom");
+ALIGNED(4) static const u8 sTop[] = _("Top");
+ALIGNED(4) static const u8 sBottom[] = _("Bottom");
+ALIGNED(4) static const u8 sMainScreenSettings[] = _("Main Screen Settings");
+ALIGNED(4) static const u8 sSubScreenSettings[] = _("Sub-Screen Settings");
+ALIGNED(4) static const u8 sEnabled[] = _("Enabled?");
+ALIGNED(4) static const u8 sYes[] = _("Yes");
+ALIGNED(4) static const u8 sNo[] = _("No");
+ALIGNED(4) static const u8 sSize[] = _("Size");
+ALIGNED(4) static const u8 sScale[] = _("Scale");
+ALIGNED(4) static const u8 sSizeGBA[] = _("GBA");
+ALIGNED(4) static const u8 sSizeDS[] = _("DS");
+ALIGNED(4) static const u8 sSize3DS[] = _("3DS");
+ALIGNED(4) static const u8 sScaleNone[] = _("None");
+ALIGNED(4) static const u8 sScaleFull[] = _("Full");
+ALIGNED(4) static const u8 sScaleStretch[] = _("Stretch");
+static const struct {
+    const u8 *name;
+    u8 count;
+    const u8 *choices[MAX_CHOICES];
+} sSettings[] = {
+    [SETTING_ENABLED] = { sEnabled, 2, { sYes, sNo } },
+    [SETTING_SIZE] = { sSize, 3, { sSizeGBA, sSizeDS, sSize3DS } },
+    [SETTING_SCALE] = { sScale, 3, { sScaleNone, sScaleFull, sScaleStretch } },
+};
+#define CHOICE_X(i) (64 + (i) * 40)
+
+static s32 EntryCount(void)
+{
+    switch (sMenu.page) {
+        case PAGE_TOP: return TOP_ENTRIES;
+        case PAGE_SUB_SCREEN: return 3;
+        default: return 2;
+    }
+}
+
+// Which setting entry `i` of the current settings page is.
+static s32 EntrySetting(s32 i)
+{
+    return sMenu.page == PAGE_SUB_SCREEN ? i : i + 1;
+}
+
+static u8 *SettingValue(s32 setting)
+{
+    s32 screen = sMenu.page == PAGE_MAIN_SCREEN ? 0 : 1;
+    if (setting == SETTING_ENABLED)
+        return &gPortConfig.subScreenDisabled;
+    return &gPortConfig.layout[screen][setting - SETTING_SIZE];
+}
+
+static void Draw(void)
+{
+    u32 win = sMenu.windowId;
+    s32 i, y;
+
+    CallPrepareTextbox_8008C54(win);
+    sub_80073B8(win);
+
+    if (sMenu.page == PAGE_TOP) {
+        PrintStringOnWindow(16, 0, sTitleTop, win, 0);
+        y = GetMenuEntryYCoord(&sMenu.input, 0);
+        PrintStringOnWindow(8, y, sMainScreen, win, 0);
+        if (sMenu.options->touchScreen)
+            AddDoubleUnderScoreHighlight(win, 80, y + 10, GetStringLineWidth(sTop), COLOR_WHITE_2);
+        else
+            AddDoubleUnderScoreHighlight(win, 120, y + 10, GetStringLineWidth(sBottom), COLOR_WHITE_2);
+        PrintStringOnWindow(8, GetMenuEntryYCoord(&sMenu.input, 1), sMainScreenSettings, win, 0);
+        PrintStringOnWindow(8, GetMenuEntryYCoord(&sMenu.input, 2), sSubScreenSettings, win, 0);
+    }
+    else {
+        PrintStringOnWindow(16, 0, sMenu.page == PAGE_MAIN_SCREEN ? sTitleMain : sTitleSub, win, 0);
+        for (i = 0; i < EntryCount(); i++) {
+            s32 setting = EntrySetting(i);
+            s32 c, value = *SettingValue(setting);
+            if (value >= sSettings[setting].count)
+                value = 0;
+            y = GetMenuEntryYCoord(&sMenu.input, i);
+            PrintStringOnWindow(8, y, sSettings[setting].name, win, 0);
+            for (c = 0; c < sSettings[setting].count; c++)
+                PrintStringOnWindow(CHOICE_X(c), y, sSettings[setting].choices[c], win, 0);
+            AddDoubleUnderScoreHighlight(win, CHOICE_X(value), y + 10, GetStringLineWidth(sSettings[setting].choices[value]), COLOR_WHITE_2);
+        }
+    }
+
+    sub_80073E0(win);
+}
+
+// Shows the window for the current page, with the cursor on `entry`.
+static void ShowPage(s32 entry)
+{
+    s32 count = EntryCount();
+
+    RestoreSavedWindows(&sMenu.windows);
+    sMenu.windows.id[sMenu.windowId] = sWindow;
+    sub_8012D08(&sMenu.windows.id[sMenu.windowId], count);
+    ResetUnusedInputStruct();
+    ShowWindows(&sMenu.windows, TRUE, TRUE);
+    CreateMenuOnWindow(&sMenu.input, count, count, sMenu.windowId);
+    MoveMenuToEntryId(&sMenu.input, entry);
+    Draw();
+}
+
+void PortScreenMenu_Create(GameOptions *options)
+{
+    sMenu.options = options;
+    sMenu.windowId = 0;
+    sMenu.page = PAGE_TOP;
+    sMenu.startConfig = gPortConfig;
+    ShowPage(0);
+}
+
+// Whether the port settings changed since the menu was opened.
+bool8 PortScreenMenu_Changed(void)
+{
+    return memcmp(&sMenu.startConfig, &gPortConfig, sizeof(gPortConfig)) != 0;
+}
+
+// 0: still open; 1: redrawn; 2: closed with B; 3: closed with A.
+u32 PortScreenMenu_Update(void)
+{
+    bool8 changed = FALSE;
+    s32 index = sMenu.input.menuIndex;
+
+    s32 input = GetMenuInput();
+
+    switch (input) {
+        case INPUT_B_BUTTON:
+        case INPUT_A_BUTTON: {
+            bool8 accept = input == INPUT_A_BUTTON;
+            if (sMenu.page != PAGE_TOP) {
+                // back to the first page, on the entry that led here
+                PlayMenuSoundEffect(accept ? MENU_SFX_ACCEPT : MENU_SFX_BACK);
+                index = sMenu.page == PAGE_MAIN_SCREEN ? 1 : 2;
+                sMenu.page = PAGE_TOP;
+                ShowPage(index);
+                return 1;
+            }
+            if (accept && index != 0) {
+                PlayMenuSoundEffect(MENU_SFX_ACCEPT);
+                sMenu.page = index == 1 ? PAGE_MAIN_SCREEN : PAGE_SUB_SCREEN;
+                ShowPage(0);
+                return 1;
+            }
+            PlayMenuSoundEffect(accept ? MENU_SFX_ACCEPT : MENU_SFX_BACK);
+            return accept ? 3 : 2;
+        }
+        case INPUT_DPAD_LEFT:
+        case INPUT_DPAD_RIGHT: {
+            s32 step = input == INPUT_DPAD_LEFT ? -1 : 1;
+            if (sMenu.page == PAGE_TOP) {
+                if (index == 0) {
+                    sMenu.options->touchScreen = !sMenu.options->touchScreen;
+                    changed = TRUE;
+                }
+            }
+            else {
+                s32 setting = EntrySetting(index);
+                s32 n = sSettings[setting].count;
+                u8 *value = SettingValue(setting);
+                *value = (*value % n + n + step) % n;
+                changed = TRUE;
+            }
+            if (changed)
+                PlayMenuSoundEffect(MENU_SFX_NAVIGATE);
+            break;
+        }
+    }
+
+    if (MenuCursorUpdate(&sMenu.input, 1) || changed) {
+        Draw();
+        return 1;
+    }
+    return 0;
+}
+
+void PortScreenMenu_Destroy(void)
+{
+    sMenu.windows.id[sMenu.windowId] = sNoWindow;
+    ResetUnusedInputStruct();
+    ShowWindows(&sMenu.windows, TRUE, TRUE);
+}
+
+#endif // PLATFORM_3DS
