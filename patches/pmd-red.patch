+static void PlayMatchGba(s32 song)
+{
+    u16 id = MatchId(song);
+
+    Port_MusicStop();
+    if (sMatchSfx) { // (another one stops the last)
+        StopFanfareSE(STOP_SOUND_EFFECT);
+        PlayFanfareSE(id, MAX_VOLUME);
+        sMatchPlayingSong = song;
+        return;
+    }
+    StopBGM();
+    if (id >= FANFARE_START_INDEX)
+        PlayFanfareSE(id, MAX_VOLUME);
+    else
+        StartNewBGM(id);
+    sMatchPlayingSong = song;
+}
+
+static void PlayMatchDs(s32 song)
+{
+    s32 track = MatchGet(song);
+
+    StopBGM();
+    StopFanfareSE(sMatchSfx ? STOP_SOUND_EFFECT : STOP_FANFARE);
+    sMatchPlayingSong = -1;
+    if (track >= 0)
+        Port_MusicPlay(track);
+    else
+        Port_MusicStop();
+}
