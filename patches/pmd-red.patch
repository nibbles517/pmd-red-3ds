+#ifdef PLATFORM_3DS
+// 3DS port: puts the current game options into the adventure saved on the
+// cartridge (both copies), leaving everything else in it as it was. Used when
+// leaving the options menus, which take effect at once.
+void Port_WriteGameOptionsToPak(void)
+{
+    // where WriteSavetoPak puts the adventure data (game options first)
+    const u32 offset = 0x4650 + 150 * 4 + 0x1D8 + 0x10 + 0x8;
+    // not from the game's heap, which has no room for it while in a menu
+    static struct UnkStruct_sub_8011DAC sBuffer;
+    struct UnkStruct_sub_8011DAC *playerSave = &sBuffer;
+    DataSerializer seri;
+    u8 bits[4];
+    s32 copy, sector = 0;
+
+    InitBitWriter(&seri, bits, sizeof(bits));
+    WriteGameOptionsBits(&seri);
+
+    for (copy = 0; copy < 2; copy++) {
+        s32 at = sector, readAt = sector;
+        u32 n = seri.unkC; // bits written
+        u8 *dst = playerSave->unk448 + offset;
+        s32 i;
+
+        sub_8011CA8((u32 *)&sector, sizeof(*playerSave));
+        if (ReadSaveSector(&readAt, (u8 *)playerSave, sizeof(*playerSave)) != READ_SAVE_VALID
+            || playerSave->checksum != 0x5071412)
+            continue;
+        for (i = 0; i < n; i++) {
+            u8 mask = 1 << (i & 7);
+            dst[i >> 3] = (dst[i >> 3] & ~mask) | (bits[i >> 3] & mask);
+        }
+        WriteSaveSector(&at, (u8 *)playerSave, sizeof(*playerSave));
+    }
+}
+#endif
+
