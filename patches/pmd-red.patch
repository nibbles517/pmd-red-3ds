+static void CreateRomBrowser(void)
+{
+    const char *picked = sRomFor == ROM_FOR_EXTRA && Port_ExtraMusicRomPath()[0] ? Port_ExtraMusicRomPath() : Port_MusicRomPath();
+
+    // the folder of the ROM picked before (gone from there now), else the
+    // last one looked in
+    if (picked[0] == '/') {
+        const char *slash = strrchr(picked, '/');
+        s32 len = (s32)(slash - picked);
+        if (len < (s32)sizeof(sRomDir)) {
+            memcpy(sRomDir, picked, len);
+            sRomDir[len > 0 ? len : 1] = 0;
+            if (len == 0)
+                sRomDir[0] = '/';
+        }
+    }
+    if (Backend_DirList(sRomDir, sRomEntries, 1) < 0) // (that folder is gone: the top one)
+        strcpy(sRomDir, "/");
+    sMusicPrevKeys = Port_KeysHeld();
+    RomShowDir(0);
+}
+
+static void RomGoUp(void)
+{
+    char *slash = strrchr(sRomDir, '/');
+    char left[136];
+    s32 i;
+
+    snprintf(left, sizeof(left), "%s", slash + 1);
+    if (slash == sRomDir)
+        sRomDir[1] = 0;
+    else
+        *slash = 0;
+    RomReadDir();
+    for (i = 0; i < sRomCount; i++) // (the cursor on the folder just left)
+        if (sRomEntries[i].isDir && strcmp(sRomEntries[i].name, left) == 0)
+            break;
+    RomShowDir(i < sRomCount ? i : 0);
+}
+
+static void HandleRomBrowser(void)
+{
+    u16 keys = Port_KeysHeld();
+    u16 pressed = keys & ~sMusicPrevKeys;
+    char path[256];
+
+    sMusicPrevKeys = keys;
+    if (pressed & START_BUTTON) {
+        PlayMenuSoundEffect(MENU_SFX_BACK);
+        SetOptionsMenuState(sRomFor == ROM_FOR_EXTRA ? OPTIONS_MENU_MUSIC_SETTINGS : OPTIONS_MENU_MAIN);
+        return;
+    }
+    switch (GetKeyPress(&sRomInput)) {
+        case INPUT_B_BUTTON:
+            PlayMenuSoundEffect(MENU_SFX_BACK);
+            if (strcmp(sRomDir, "/") == 0) {
+                SetOptionsMenuState(sRomFor == ROM_FOR_EXTRA ? OPTIONS_MENU_MUSIC_SETTINGS : OPTIONS_MENU_MAIN);
+                return;
+            }
+            RomGoUp();
+            return;
+        case INPUT_A_BUTTON: {
+            const PortDirEntry *e;
+            s32 r;
+            if (sRomCount == 0)
+                return;
+            e = &sRomEntries[GET_CURRENT_MENU_ENTRY(sRomInput)];
+            RomPath(path, sizeof(path), e->name);
+            if (strlen(path) >= sizeof(sRomDir) - 1) {
+                sRomStatus = sRomCantRead;
+                DrawRomInfo();
+                return;
+            }
+            if (e->isDir) {
+                PlayMenuSoundEffect(MENU_SFX_ACCEPT);
+                strcpy(sRomDir, path);
+                RomShowDir(0);
+                return;
+            }
+            if (sRomFor == ROM_FOR_EXTRA) {
+                // Explorers of Sky's only: Extra Music on, back to Music Options;
+                // another game's (even Explorers of Time or Darkness): says so
+                r = Port_ExtraMusicTryRom(path);
+                if (r < 0) {
+                    PlayMenuSoundEffect(MENU_SFX_FAIL);
+                    sRomStatus = sRomCantOpen;
+                    DrawRomInfo();
+                    return;
+                }
+                if (r == 0) {
+                    PlayMenuSoundEffect(MENU_SFX_FAIL);
+                    SetOptionsMenuState(OPTIONS_MENU_EXTRA_WRONG);
+                    return;
+                }
+                PlayMenuSoundEffect(MENU_SFX_ACCEPT);
+                gPortConfig.extraMusic = 1;
+                Port_SaveConfig();
+                SetOptionsMenuState(OPTIONS_MENU_MUSIC_SETTINGS);
+                return;
+            }
+            r = Port_MusicTryRom(path);
+            if (r < 0) {
+                PlayMenuSoundEffect(MENU_SFX_FAIL);
+                sRomStatus = sRomCantOpen;
+                DrawRomInfo();
+                return;
+            }
+            PlayMenuSoundEffect(MENU_SFX_ACCEPT);
+            if (sRomFor == MENU_OPTION_MUSIC) {
+                // Blue Rescue Team's: Music Options; another game's: says so,
+                // then its music here only (as before)
+                sMusicLocked = r == 0;
+                SetOptionsMenuState(sMusicLocked ? OPTIONS_MENU_MUSIC_OTHER : OPTIONS_MENU_MUSIC_SETTINGS);
+            }
+            else
+                SetOptionsMenuState(r == 0 ? OPTIONS_MENU_MUSIC_MATCH_OTHER : OPTIONS_MENU_MUSIC_MATCH);
+            return;
+        }
+        default:
+            if (MenuCursorUpdate(&sRomInput, TRUE)) {
+                sRomStatus = NULL;
+                DrawRomList();
+                DrawRomInfo();
+            }
+            break;
+    }
+}
