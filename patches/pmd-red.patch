+            for (j = 0; j < n && shinies[j] != species; j++)
+                ;
+            if (j == n)
+                shinies[n++] = species;
+        }
+        else if (sprite->unk68 >= 0 && sprite->unk68 < SHINY_SLOTS) {
+            needed[sprite->unk68] = TRUE;
+        }
+    }
+    // Shinies keep the palette they had while it's still spare
+    for (slot = 0; slot < SHINY_SLOTS; slot++) {
+        bool8 keep = FALSE;
+        if (sShinySlot[slot] != 0 && !needed[slot]) {
+            for (j = 0; j < n; j++) {
+                if (shinies[j] == sShinySlot[slot]) {
+                    shinies[j] = 0;
+                    keep = TRUE;
+                    break;
+                }
+            }
+        }
+        if (!keep)
+            sShinySlot[slot] = 0;
+    }
+    for (j = 0; j < n; j++) {
+        if (shinies[j] == 0)
+            continue;
+        for (slot = SHINY_SLOTS - 1; slot >= 0; slot--) {
+            if (!needed[slot] && sShinySlot[slot] == 0) {
+                sShinySlot[slot] = shinies[j];
+                break;
+            }
+        }
+    }
+    for (slot = 0; slot < SHINY_SLOTS; slot++) {
+        if (sShinySlot[slot] != 0) {
+            // (every frame: the game may have loaded the palettes again)
+            const u8 (*pal)[3] = PortShiny_SpeciesPalette(sShinySlot[slot]);
+            for (i = 0; i < 16; i++) {
+                RGB_Array c = {{ pal[i][0], pal[i][1], pal[i][2], 0x80 }};
+                sub_809971C(0x100 + slot * 16 + i, &c, 1);
+            }
