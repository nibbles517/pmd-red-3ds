+// ... and leaving a page writes what changed and says so.
+static void PortFinishOptions(void)
+{
+    static const u8 sChangesSaved[] = _("Changes saved.");
+    bool8 gameChanged = memcmp(gGameOptionsRef, &sOpenedGameOptions, sizeof(GameOptions)) != 0;
+    bool8 portChanged = PortValuesChanged();
+
+    if (!gameChanged && !portChanged)
+        return;
+    if (gameChanged)
+        Port_WriteGameOptionsToPak();
+    if (portChanged)
+        Port_SaveConfig();
+    DisplayDungeonMessage_Async(NULL, sChangesSaved, TRUE);
+}
+
+// FALSE: the row has no choices (it opens a page).
+static bool8 PortChangeValue(s32 row, s32 step)
+{
+    s32 n = sPortRows[sPortPage][row].count;
+    if (n == 0)
+        return FALSE;
+    sPortValues[sPortPage][row] = (sPortValues[sPortPage][row] + n + step) % n;
+    return TRUE;
+}
