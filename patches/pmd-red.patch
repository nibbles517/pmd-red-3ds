+            OpenedFile *file = OpenFileAndGetFileDataPtr("palet", &gMonsterFileArchive);
+            sub_809971C(0x100 + slot * 16, (RGB_Array *)((const u8 *)file->data + slot * 0x40), 16);
+            CloseFile(file);
+        }
+    }
+}
