+static bool8 SaveMatches(void)
+{
+    static int ids[MATCH_SONGS];
+    static const char *names[MATCH_SONGS];
+    s32 i;
+
+    if (sBalance) {
+        sBalanceChanged = FALSE;
+        return Port_TrackGainsSave();
+    }
+
+    for (i = 0; i < MATCH_SONGS; i++) {
+        ids[i] = sMatchSongs[i].id;
+        names[i] = sMatchSongs[i].name;
+    }
+    return Port_MusicMapSave(ids, names, MATCH_SONGS);
+}
