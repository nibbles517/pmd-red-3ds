+
+static void ShinyMade(struct UnkGroundSpriteStruct *sprite, s32 species)
+{
+    s32 i;
+    bool8 shiny = sShinyNext;
+
+    sShinyNext = FALSE;
+    ShinyForget(sprite);
+    if (!shiny || PortShiny_SpeciesPalette(species) == NULL)
+        return;
+    for (i = 0; i < UNK_3001B7C_SUB0_COUNT; i++) {
+        if (sShinySprites[i].sprite == NULL) {
+            sShinySprites[i].sprite = sprite;
+            sShinySprites[i].species = species;
+            return;
+        }
+    }
+}
+
+static s32 ShinySpecies(struct UnkGroundSpriteStruct *sprite)
+{
+    s32 i;
+    for (i = 0; i < UNK_3001B7C_SUB0_COUNT; i++)
+        if (sShinySprites[i].sprite == sprite)
+            return sShinySprites[i].species;
+    return 0;
+}
+
+static void ShinyChooseSlots(void)
+{
+    bool8 needed[SHINY_SLOTS] = {0};
+    s16 shinies[UNK_3001B7C_SUB0_COUNT];
+    s16 old[SHINY_SLOTS];
+    s32 n = 0, i, j, slot;
