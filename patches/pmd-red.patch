@@ -0,0 +1,68 @@
+// 3DS port: where story scenes' Pokémon start, moved for the wider sizes so
+// they come in from off the screen instead of appearing on it (they walk to
+// the same places after: scripts walk to points on the map). Pixels, + right
+// and down; x for Fit and 3DS sizes each, y for both (DS and GBA: as the game).
+// Applied when a scene's Pokémon are placed (ground_lives.c).
+//   walkIn: for one whose script moves it away and walks it back by so much
+//   (a jump by 0x59, then WALK_RELATIVE): that first walk goes as much
+//   further, so it still ends where it did.
+//   map, group, sector: the scene's (its station: ground_data_*_station.h,
+//   s_gs<map>_g<group>_s<sector>_lives); index: its place in that list.
+// The team base is one map per partner and upgrade (MAP_TEAM_BASE_EEVEE_FINAL
+// ...), all with the same scenes: MAP_TEAM_BASE (outside) or
+// MAP_TEAM_BASE_INSIDE_PIKACHU_BASIC (inside) in these tables for all of them.
+static inline s32 PortSceneMap(s32 map)
+{
+    if (map >= MAP_TEAM_BASE_PIKACHU_BASIC && map <= MAP_TEAM_BASE_INSIDE_TREECKO_FINAL)
+        return (map - MAP_TEAM_BASE_PIKACHU_BASIC) % 6 >= 3 ? MAP_TEAM_BASE_INSIDE_PIKACHU_BASIC : MAP_TEAM_BASE_PIKACHU_BASIC;
+    return map;
+}
+
+static const struct PortSpawnNudge {
+    s16 map;
+    s8 group, sector, index;
+    s16 xFit, x3ds, y;
+    bool8 walkIn;
+} sPortSpawnNudges[] = {
+    // EVENT_M01E01A_L001 (Tiny Woods, the hero wakes up): Butterfree
+    { MAP_TINY_WOODS_ENTRY, 1, 1, 0, -96, -96, 0, FALSE },
+    // EVENT_M01E01A_L003 (Tiny Woods' end, finding Caterpie): the hero and the partner
+    { MAP_TINY_WOODS_END, 1, 0, 0, 0, 0, 24, FALSE },
+    { MAP_TINY_WOODS_END, 1, 0, 1, 0, 0, 24, FALSE },
+    // EVENT_M01E02A_L002 (team base, Pelipper brings the mail): Pelipper
+    { MAP_TEAM_BASE, 18, 0, 2, 136, 176, 0, FALSE },
+    // EVENT_M01E02A_L003 and L005 (Thunderwave Cave's entrance): the hero and the partner
+    { MAP_THUNDERWAVE_CAVE_ENTRY, 1, 0, 0, 0, 0, 24, TRUE },
+    { MAP_THUNDERWAVE_CAVE_ENTRY, 1, 0, 1, 0, 0, 24, TRUE },
+    { MAP_THUNDERWAVE_CAVE_ENTRY, 2, 0, 0, 0, 0, 24, TRUE },
+    { MAP_THUNDERWAVE_CAVE_ENTRY, 2, 0, 1, 0, 0, 24, TRUE },
+    // EVENT_M01E02A_L006 (Thunderwave Cave's end): the hero and the partner
+    { MAP_THUNDERWAVE_CAVE_END, 1, 0, 0, 0, 0, 24, FALSE },
+    { MAP_THUNDERWAVE_CAVE_END, 1, 0, 1, 0, 0, 24, FALSE },
+    // EVENT_M01E02B_L004B (team base): the partner
+    { MAP_TEAM_BASE, 26, 0, 1, 0, 0, 24, TRUE },
+    // EVENT_M01E03A_L005 (team base, Team Meanies visit): Gengar, Ekans and
+    // Medicham come up from further down; Pelipper starts off the right
+    { MAP_TEAM_BASE, 30, 0, 2, 0, 0, 128, FALSE },
+    { MAP_TEAM_BASE, 30, 0, 3, 0, 0, 128, FALSE },
+    { MAP_TEAM_BASE, 30, 0, 4, 0, 0, 128, FALSE },
+    { MAP_TEAM_BASE, 30, 0, 5, 136, 176, 0, FALSE },
+};
+
+// ... and points on the map scenes walk Pokémon to (s_gs<map>_links), moved
+// the same way: for one that walks off the screen and disappears there, so it
+// does that past the wider screen's edge. Every scene of the map that walks
+// to the point goes to the moved one.
+static const struct PortLinkNudge {
+    s16 map, link;
+    s16 xFit, x3ds, y;
+} sPortLinkNudges[] = {
+    // EVENT_M01E01A_L003 (Tiny Woods, after rescuing Caterpie): Butterfree and Caterpie leave to the right
+    { MAP_TINY_WOODS_ENTRY, 14, 48, 64, 0 },
+    { MAP_TINY_WOODS_ENTRY, 15, 48, 64, 0 },
+    // The team base: where Pelipper flies off to after bringing mail (every such scene)
+    { MAP_TEAM_BASE, 4, -96, -128, 0 },
+    // EVENT_M01E02A_L006 (Thunderwave Cave's entrance): the Magnemite leave downwards
+    { MAP_THUNDERWAVE_CAVE_ENTRY, 2, 0, 0, 24 },
+    { MAP_THUNDERWAVE_CAVE_ENTRY, 3, 0, 0, 24 },
+};
