+        PrintStringOnWindow(8, GetMenuEntryYCoord(in, 0), sRomEmpty, ROM_LIST_WIN, 0);
+    for (i = 0; i < in->currPageEntries && sRomCount > 0; i++) {
+        const PortDirEntry *e = &sRomEntries[in->currPage * in->entriesPerPage + i];
+        snprintf(name, sizeof(name), "%s%s", e->name, e->isDir ? "/" : "");
+        MusicLabel(text, 38, name);
