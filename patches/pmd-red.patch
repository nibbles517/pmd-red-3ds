+// A label in the game's characters: letters, digits and a few signs (the
+// game's text has commands of its own, as "#C").
+static void MusicLabel(u8 *out, s32 size, const char *in)
+{
+    s32 n = 0;
+    while (*in != '\0' && n < size - 1) {
+        char c = *in++;
+        if (!((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9')
+              || c == ' ' || c == '_' || c == '-' || c == '.' || c == ':' || c == '(' || c == ')' || c == '/'))
+            c = '?';
+        out[n++] = c;
+    }
+    out[n] = '\0';
+}
