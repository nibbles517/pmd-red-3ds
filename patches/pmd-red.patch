+// The palette to draw a ground sprite with: a shiny one's borrowed one, else its own
+static s32 ShinyGroundPalette(struct UnkGroundSpriteStruct *sprite)
+{
+    s32 species, slot;
+
+    if (sShinyFrame != Port_FrameCount()) {
+        sShinyFrame = Port_FrameCount();
+        ShinyChooseSlots();
+    }
+    species = ShinySpecies(sprite);
+    if (species != 0)
+        for (slot = 0; slot < SHINY_SLOTS; slot++)
+            if (sShinySlot[slot] == species)
+                return slot;
+    return sprite->unk68;
+}
