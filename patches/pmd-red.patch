+static void BuildSfxIds(void)
+{
+    u32 r;
+    s32 id;
+    sSfxCount = 0;
+    for (r = 0; r < sizeof(sSfxRanges) / sizeof(sSfxRanges[0]); r++)
+        for (id = sSfxRanges[r].first; id <= sSfxRanges[r].last && sSfxCount < (s32)ARRAY_COUNT(sSfxIds); id++)
+            sSfxIds[sSfxCount++] = (u16)id;
+}
