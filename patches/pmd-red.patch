+// DS Volume Balance's sound effects: SELECT, a DS song under the effects
+// (on, off), SELECT held with L/R or ZL/ZR another one.
+static s16 sMatchBgmLast = -1; // (the song SELECT plays again)
+
+static bool8 MatchSfxKeys(u16 keys, u16 pressed)
+{
+    if (keys & SELECT_BUTTON) {
+        s32 step = (gRealInputs.pressed & L_BUTTON) ? -1 : (gRealInputs.pressed & R_BUTTON) ? 1
+                 : (pressed & PORT_KEY_ZL) ? -10 : (pressed & PORT_KEY_ZR) ? 10 : 0;
+        if (step != 0 && Port_MusicSongCount() > 0) {
+            s32 n = Port_MusicSongCount(), cur = gPortMatchBgm >= 0 ? gPortMatchBgm : sMatchBgmLast >= 0 ? sMatchBgmLast : 0;
+            cur = ((cur + step) % n + n) % n;
+            gPortMatchBgm = sMatchBgmLast = (s16)cur;
+            sMatchStatus = NULL;
+            return TRUE;
+        }
+    }
+    if (pressed & SELECT_BUTTON) { // (on, off)
+        if (gPortMatchBgm >= 0)
+            gPortMatchBgm = -1;
+        else if (Port_MusicSongCount() > 0)
+            gPortMatchBgm = sMatchBgmLast = sMatchBgmLast >= 0 ? sMatchBgmLast : 0;
+        sMatchStatus = NULL;
+        return TRUE;
+    }
+    return FALSE;
+}
+
+static void HandleMatchMenu(void)
+{
+    u16 keys = Port_KeysHeld();
+    u16 pressed = keys & ~sMusicPrevKeys;
+    s32 song = GET_CURRENT_MENU_ENTRY(sMatchInput);
+    s32 step = 0;
+    bool8 redraw = FALSE;
+
+    sMusicPrevKeys = keys;
+    // The DS side's volume (the sound effects' or the music's): Circle Pad up/down
+    if (!sMatchSfx && MusicVolumeKeys(keys, PORT_KEY_CPAD_UP, PORT_KEY_CPAD_DOWN, FALSE))
+        redraw = TRUE;
+    if (sMatchSfx && MatchSfxKeys(keys, pressed)) {
+        DrawMatchList();
+        DrawMatchInfo();
+        return;
+    }
+    if (gRealInputs.pressed & L_BUTTON)
+        step = -1;
+    else if (gRealInputs.pressed & R_BUTTON)
+        step = 1;
+    else if (pressed & PORT_KEY_ZL)
+        step = -10;
+    else if (pressed & PORT_KEY_ZR)
+        step = 10;
+
+    if (step != 0 && sBalance) { // the DS track's own volume, heard at once
+        s32 track = MatchGet(song);
+        if (track >= 0) {
+            s32 g = Port_TrackGainGet(track) + step, max = Port_TrackGainMax(track);
+            Port_TrackGainSet(track, g < 0 ? 0 : g > max ? max : g);
+            sBalanceChanged = TRUE;
+            if (sMatchSfx || Port_MusicPlaying() != track) // (a song playing: louder or softer as it plays)
+                PlayMatchDs(song);
+        }
+        sMatchStatus = NULL;
+        redraw = TRUE;
+    }
+    else if (step != 0) { // another DS track for this one, played at once
+        // (music: the tracks before the sound effects; sound effects: those after)
+        s32 first = 0, last = Port_MusicSongCount() - 1;
+        s32 track = MatchGet(song);
+        track = track < 0 ? (step > 0 ? first + step - 1 : last + 1 + step) : track + step;
+        if (track < first)
+            track = first;
+        if (track > last)
+            track = last;
+        MatchSet(song, track);
+        PlayMatchDs(song);
+        sMatchStatus = NULL;
+        redraw = TRUE;
+    }
+    else if (gRealInputs.pressed & START_BUTTON) {
+        sMatchStatus = SaveMatches() ? (sBalance ? sBalanceSaved : sMatchSaved) : (sBalance ? sBalanceNotSaved : sMatchNotSaved);
+        PlayMenuSoundEffect(MENU_SFX_ACCEPT);
+        redraw = TRUE;
+    }
+    else if ((pressed & PORT_KEY_X) && sBalance) { // the other list
+        if (sMatchSfx)
+            sMatchCursorSfx = song;
+        else
+            sMatchCursor = song;
+        sMatchSfx = !sMatchSfx;
+        gPortMatchBgm = -1;
+        Port_MusicStop();
+        StopBGM();
+        StopFanfareSE(STOP_FANFARE);
+        StopFanfareSE(STOP_SOUND_EFFECT);
+        sMatchPlayingSong = -1;
+        sMatchStatus = NULL;
+        CreateMenuOnWindow(&sMatchInput, MatchCount(), MUSIC_PER_PAGE, MUSIC_LIST_WIN);
+        MoveMenuToEntryId(&sMatchInput, sMatchSfx ? sMatchCursorSfx : sMatchCursor);
+        PlayMenuSoundEffect(MENU_SFX_NAVIGATE);
+        redraw = TRUE;
+    }
+    else if (pressed & PORT_KEY_X) {
+        MatchSet(song, -1);
+        Port_MusicStop();
+        sMatchStatus = NULL;
+        redraw = TRUE;
+    }
+    else if (pressed & PORT_KEY_Y) {
+        PlayMatchDs(song);
+        sMatchStatus = NULL;
+        redraw = TRUE;
+    }
+    else {
+        switch (GetKeyPress(&sMatchInput)) {
+            case INPUT_B_BUTTON:
+                PlayMenuSoundEffect(MENU_SFX_BACK);
+                if (!sBalance || sBalanceChanged)
+                    SaveMatches();
+                if (sMatchVolumes[0] != gPortConfig.musicVolume || sMatchVolumes[1] != gPortConfig.sfxVolume)
+                    Port_SaveConfig();
+                if (sMatchSfx)
+                    sMatchCursorSfx = song;
+                else
+                    sMatchCursor = song;
+                gPortMatchBgm = -1;
+                Port_MusicClose();
+                StopBGM();
+                StopFanfareSE(STOP_FANFARE);
+                StopFanfareSE(STOP_SOUND_EFFECT);
+                gPortDsMusicOff = FALSE;
+                gPortRawXY = FALSE;
+                Port_DsMusicRecheck();
+                StartNewBGM(MUS_FILE_SELECT); // the title's music again
+                SetOptionsMenuState(OPTIONS_MENU_MAIN);
+                return;
+            case INPUT_A_BUTTON:
+                PlayMatchGba(song);
+                sMatchStatus = NULL;
+                redraw = TRUE;
+                break;
+            default: {
+                s32 before = GET_CURRENT_MENU_ENTRY(sMatchInput);
+                if (MenuCursorUpdate(&sMatchInput, TRUE))
+                    redraw = TRUE;
+                if (GET_CURRENT_MENU_ENTRY(sMatchInput) != before) {
+                    sMatchStatus = NULL;
+                    DrawMatchInfo();
+                }
+                break;
+            }
+        }
+    }
+    if (redraw) {
+        DrawMatchList();
+        DrawMatchInfo();
+    }
+}
