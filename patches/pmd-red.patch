+// Sound Effect Matching: the game's sound effects, the songs from 300 on in its
+// song table (sound/song_table.inc), each matched with one of the DS's
+// (port/core/music.c: sfx-map.txt). The same screen and buttons.
+static const struct { u16 first, last; } sSfxRanges[] = {
+    { 301, 313 }, { 330, 333 }, { 335, 348 }, { 351, 372 }, { 390, 392 },
