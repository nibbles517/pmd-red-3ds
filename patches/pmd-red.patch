+static s32 MatchGet(s32 i) { return sMatchSfx ? Port_SfxMapGet(MatchId(i)) : Port_MusicMapGet(MatchId(i)); }
+static void MatchSet(s32 i, s32 track)
+{
+    if (sMatchSfx)
+        Port_SfxMapSet(MatchId(i), track);
+    else
+        Port_MusicMapSet(MatchId(i), track);
+}
