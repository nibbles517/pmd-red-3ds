diff --git a/include/port_new_run.h b/include/port_new_run.h
new file mode 100644
index 00000000..1b7ab65e
--- /dev/null
+++ b/include/port_new_run.h
@@ -0,0 +1,54 @@
+#ifndef GUARD_PORT_NEW_RUN_H
+#define GUARD_PORT_NEW_RUN_H
+
+// 3DS port: the run options, chosen once after New Game (src/port_new_run.c).
+#define PORT_RUN_OPTIONS 8
+extern u8 gPortRunOptions[PORT_RUN_OPTIONS]; // 0 Off, 1 On; each Save Data's in config.ini
+// What they do (index in gPortRunOptions):
+// (dungeon_floor_spawns.c, PortRunItemChange) Increased Sitrus Berries: any
+// other rolled Berry is a Sitrus Berry 2% of the time; Increased Life Seeds:
+// any other rolled Seed is a Life Seed 2% of the time; Increased Vitamins: a
+// rolled Max Elixir is Protein, Iron, Calcium or Zinc (25% each) 5% of the
+// time. Doubled (4%, 4%, 10%) while the team leader holds a Plain Ribbon,
+// except for a Kecleon Shop's items (always 2%, 2%, 5%).
+#define PORT_RUN_ORAN_TO_SITRUS 0
+#define PORT_RUN_BLAST_TO_LIFE 1
+#define PORT_RUN_ELIXIR_TO_VITAMIN 2
+// Blue Exclusive Pokémon: Blue Rescue Team's exclusives (Magikarp, Lapras...)
+// count as unlocked, without Wonder Mail (exclusive_pokemon.c)
+#define PORT_RUN_BLUE_EXCLUSIVES 3
+// Shiny Pokémon: a wild Pokémon is shiny 1 time in PORT_SHINY_ODDS
+// (dungeon_mon_spawn.c), with its own colors (port_shiny.c)
+#define PORT_RUN_SHINY 4
+#define PORT_SHINY_ODDS 4096
+// After the save's roster and dungeon team, and the quicksave: then each one's shiny bit
+u8 PortShinyRoll(void); // (pokemon.c: 1 in PORT_SHINY_ODDS with the option on)
+#define PORT_SHINY_MAGIC 0x594E4853 // "SHNY"
+// port_shiny.c
+struct EntityInfo;
+s32 PortShiny_DungeonPalette(struct EntityInfo *info, s32 normal);
+void PortShiny_DungeonPalettesLoaded(void);
+bool8 PortShiny_SlotColors(s32 slot, u16 *out); // (a shiny's colors in OBJ palette slot, r g b 0-31)
+struct RGB_Struct;
+const u8 (*PortShiny_SpeciesPalette(s32 species))[3];
+void PortShiny_GroundNext(bool8 shiny); // (ground_sprite.c: the next monster sprite made is a shiny one's)
+// Normalized Shop Prices: items.c prices items by data/port_shop_prices.h
+#define PORT_RUN_SHOP_PRICES 7
+void PortNewRun_Run(void (*frameActions)(u32));
+
+
+// Others > Cheats (in dungeons: dungeon_menu_others.c), each Save Data's own
+// (config.ini, as its run options). 0 off, 1 on; CHEAT_EXP: 0 off, 1 0x (no Exp.
+// Points gained at all), 2-8 2x-128x (by name in config.ini).
+enum {
+    CHEAT_INF_HP, CHEAT_INF_PP, CHEAT_INF_BELLY, CHEAT_ONE_HIT, CHEAT_ACCURACY, CHEAT_EXP, // Stats
+    CHEAT_ANY_TM, CHEAT_RECRUIT, CHEAT_XRAY, CHEAT_LUMINOUS, CHEAT_NOSTICK, CHEAT_GOGGLE, // Effects
+    CHEAT_WEATHER, CHEAT_TWIST, CHEAT_MOBILE, CHEAT_PIERCE, CHEAT_SNEAK,
+    PORT_CHEATS
+};
+#define CHEAT_EXP_MAX 8
+#define CHEAT_EXP_NONE 1 // (0x)
+extern u8 gPortCheats[PORT_CHEATS];
+void Port_CheatsSave(void); // (options.c: gPortCheats as its Save Data's, config.ini written)
+
+#endif
