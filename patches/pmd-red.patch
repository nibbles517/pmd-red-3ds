@@ -0,0 +1,452 @@
+// 3DS port: Others > Graphics Options (outside dungeons).
+//
+// Built like the game's own Game Options window (options_menu2.c):
+//   Frame Skip             Off / Auto / Always (port/core/frame.c)
+//   Dual Core              Off / On: the second CPU core makes the DS music
+//                          and sound effects (port/core/music.c)
+//   GPU Drawing            Off / On: the main screen drawn by the GPU, from the
+//                          drawing list (port/core/gpulist.h, docs/GPU.md)
+//   Main Screen            Top / Bottom (kept in the save's game options, in the
+//                          bit the DS version uses for its touch screen option:
+//                          clear = bottom, set = top)
+//   Main Screen Settings   a page of two toggles, Size (GBA/DS/3DS) and
+//                          Scale (None/Full/Stretch: 1:1, as large as fits,
+//                          the whole screen; port/3ds/main.c ScaleRect)
+//   Sub-Screen Settings    Enabled? (Yes/No: turns the second screen on/off),
+//                          then the same Size and Scale
+// The page settings live in the port's own config file (gPortConfig). Every
+// toggle takes effect as soon as it changes; the file is written when the
+// menu is left (options_menu1.c, "Changes saved.").
+#include <stdio.h>
+#include <string.h>
+#include "global.h"
+#include "globaldata.h"
+#include "constants/colors.h"
+#include "constants/input.h"
+#include "music_util.h"
+#include "input.h"
+#include "menu_input.h"
+#include "port_screen_menu.h"
+#include "port_game.h"
+#include "text_1.h"
+#include "text_2.h"
+#include "text_3.h"
+
+#ifdef PLATFORM_3DS
+
+enum { PAGE_TOP, PAGE_MAIN_SCREEN, PAGE_SUB_SCREEN, PAGE_CONTROLS, PAGE_MUSIC };
+// First page entries
+enum { TOP_FRAMESKIP, TOP_DUALCORE, TOP_GPU, TOP_BUSY, TOP_MAIN_SCREEN, TOP_MAIN_SETTINGS, TOP_SUB_SETTINGS };
+
+#define TOP_ENTRIES 7
+#define MAX_CHOICES 4
+
+enum { SETTING_ENABLED, SETTING_SIZE, SETTING_SCALE, SETTING_FRAMESKIP, SETTING_BUTTONS, SETTING_TOUCH, SETTING_MUSIC_STYLE, SETTING_SFX_STYLE };
+// Music Options: Music Style, then Music Player (no choices: opens the player)
+enum { MUSIC_STYLE, MUSIC_SFX, MUSIC_VOLUME, MUSIC_SFX_VOLUME, MUSIC_PLAYER };
+// (entries that aren't settings with choices: EntrySetting's)
+enum { ENTRY_PLAYER = -1, ENTRY_MUSIC_VOLUME = -2, ENTRY_SFX_VOLUME = -3 };
+
+static struct {
+    GameOptions *options;
+    MenuInputStruct input;
+    u32 windowId;
+    WindowTemplates windows;
+    s32 page;
+    struct PortConfig startConfig; // the settings when the menu was opened
+    bool8 musicLocked; // Music Options for another game's ROM: GBA music only
+} sMenu;
+
+static const WindowTemplate sNoWindow = { 0, 3, 0, 0, 0, 0, 0, 0, NULL };
+static const WindowHeader sHeader = { 1, 0, 15, 0 };
+static const WindowTemplate sWindow = {
+    0,
+    6,
+    2, 2,
+    26, 16, // wide enough for four Size choices
+    18, 0,
+    &sHeader
+};
+
+ALIGNED(4) static const u8 sTitleTop[] = _("Graphics Options");
+ALIGNED(4) static const u8 sTitleMain[] = _("Main Screen Settings");
+ALIGNED(4) static const u8 sTitleSub[] = _("Sub-Screen Settings");
+ALIGNED(4) static const u8 sFrameSkip[] = _("Frame Skip");
+ALIGNED(4) static const u8 sOff[] = _("Off");
+ALIGNED(4) static const u8 sAuto[] = _("Auto");
+ALIGNED(4) static const u8 sAlways[] = _("Always");
+ALIGNED(4) static const u8 sDualCore[] = _("Dual Core");
+ALIGNED(4) static const u8 sGpuDraw[] = _("GPU Drawing");
+ALIGNED(4) static const u8 sBusy[] = _("Busy Screen");
+ALIGNED(4) static const u8 sWait[] = _("Wait");
+ALIGNED(4) static const u8 sSkip[] = _("Skip");
+ALIGNED(4) static const u8 sOn[] = _("On");
+ALIGNED(4) static const u8 sMainScreen[] = _("Main Screen{MOVE_X_POSITION_BY_80}Top{MOVE_X_POSITION_BY_120}Bottom");
+ALIGNED(4) static const u8 sTop[] = _("Top");
+ALIGNED(4) static const u8 sBottom[] = _("Bottom");
+ALIGNED(4) static const u8 sMainScreenSettings[] = _("Main Screen Settings");
+ALIGNED(4) static const u8 sSubScreenSettings[] = _("Sub-Screen Settings");
+ALIGNED(4) static const u8 sEnabled[] = _("Enabled?");
+ALIGNED(4) static const u8 sYes[] = _("Yes");
+ALIGNED(4) static const u8 sNo[] = _("No");
+ALIGNED(4) static const u8 sSize[] = _("Size");
+ALIGNED(4) static const u8 sScale[] = _("Scale");
+ALIGNED(4) static const u8 sSizeGBA[] = _("GBA");
+ALIGNED(4) static const u8 sSizeDS[] = _("DS");
+ALIGNED(4) static const u8 sSizeFit[] = _("Fit");
+ALIGNED(4) static const u8 sSize3DS[] = _("3DS");
+ALIGNED(4) static const u8 sScaleNone[] = _("None");
+ALIGNED(4) static const u8 sScaleFull[] = _("Full");
+ALIGNED(4) static const u8 sScaleStretch[] = _("Stretch");
+ALIGNED(4) static const u8 sTitleControls[] = _("Controls Options");
+ALIGNED(4) static const u8 sButtonStyle[] = _("Button Style");
+ALIGNED(4) static const u8 sTouchScreen[] = _("Touch Screen");
+ALIGNED(4) static const u8 sTitleMusic[] = _("Music Options");
+ALIGNED(4) static const u8 sMusicStyle[] = _("Music Style");
+ALIGNED(4) static const u8 sMusicPlayer[] = _("Music Player");
+ALIGNED(4) static const u8 sSfxStyle[] = _("Sound Effects");
+ALIGNED(4) static const u8 sMusicVolume[] = _("Music Volume");
+ALIGNED(4) static const u8 sSfxVolume[] = _("SFX Volume");
+#define VOLUME_MIN 1 // (tens of percent, as gPortConfig.musicVolume / sfxVolume)
+#define VOLUME_MAX 40
+static const struct {
+    const u8 *name;
+    u8 count;
+    const u8 *choices[MAX_CHOICES];
+} sSettings[] = {
+    [SETTING_ENABLED] = { sEnabled, 2, { sYes, sNo } },
+    [SETTING_SIZE] = { sSize, 4, { sSizeGBA, sSizeDS, sSizeFit, sSize3DS } },
+    [SETTING_SCALE] = { sScale, 3, { sScaleNone, sScaleFull, sScaleStretch } },
+    [SETTING_FRAMESKIP] = { sFrameSkip, 3, { sOff, sAuto, sAlways } },
+    [SETTING_BUTTONS] = { sButtonStyle, 3, { sSizeGBA, sSizeDS, sSize3DS } },
+    [SETTING_TOUCH] = { sTouchScreen, 2, { sOn, sOff } },
+    [SETTING_MUSIC_STYLE] = { sMusicStyle, 2, { sSizeGBA, sSizeDS } },
+    [SETTING_SFX_STYLE] = { sSfxStyle, 2, { sSizeGBA, sSizeDS } },
+};
+// (Controls Options: further right, past the longer names)
+#define CHOICE_X(i) (sMenu.page == PAGE_CONTROLS || sMenu.page == PAGE_MUSIC ? 96 + (i) * 32 : 64 + (i) * 40)
+#define FRAMESKIP_X(i) (80 + (i) * 40) // as Main Screen's choices
+
+static s32 EntryCount(void)
+{
+    switch (sMenu.page) {
+        case PAGE_TOP: return TOP_ENTRIES;
+        case PAGE_SUB_SCREEN: return 3;
+        case PAGE_CONTROLS: return 2;
+        case PAGE_MUSIC: return 5;
+        default: return 2;
+    }
+}
+
+// Which setting entry `i` of the current settings page is.
+static s32 EntrySetting(s32 i)
+{
+    if (sMenu.page == PAGE_CONTROLS)
+        return SETTING_BUTTONS + i;
+    if (sMenu.page == PAGE_MUSIC)
+        return i == MUSIC_STYLE ? SETTING_MUSIC_STYLE : i == MUSIC_SFX ? SETTING_SFX_STYLE
+             : i == MUSIC_VOLUME ? ENTRY_MUSIC_VOLUME : i == MUSIC_SFX_VOLUME ? ENTRY_SFX_VOLUME : ENTRY_PLAYER;
+    return sMenu.page == PAGE_SUB_SCREEN ? i : i + 1;
+}
+
+static u8 *SettingValue(s32 setting)
+{
+    s32 screen = sMenu.page == PAGE_MAIN_SCREEN ? 0 : 1;
+    if (setting == SETTING_BUTTONS)
+        return &gPortConfig.buttonStyle;
+    if (setting == SETTING_TOUCH)
+        return &gPortConfig.touchScreenOff;
+    if (setting == SETTING_MUSIC_STYLE)
+        return &gPortConfig.musicStyle;
+    if (setting == SETTING_SFX_STYLE)
+        return &gPortConfig.sfxStyle;
+    if (setting == SETTING_ENABLED)
+        return &gPortConfig.subScreenDisabled;
+    if (setting == SETTING_FRAMESKIP)
+        return &gPortConfig.frameSkip;
+    return &gPortConfig.layout[screen][setting - SETTING_SIZE];
+}
+
+// The first choice a setting offers on this page: the second screen has no
+// GBA size (it is always DS-sized), so its Size starts at DS.
+static s32 FirstChoice(s32 setting)
+{
+    return setting == SETTING_SIZE && sMenu.page == PAGE_SUB_SCREEN ? PORT_SIZE_DS : 0;
+}
+
+// Settings (setting, or one of its choices) that do nothing yet are shown in
+// red: Touch Screen; the 3DS size for the second screen.
+static bool8 IsPlaceholder(s32 setting, s32 choice)
+{
+    if (setting == SETTING_TOUCH)
+        return TRUE;
+    if (setting == SETTING_MUSIC_STYLE || setting == SETTING_SFX_STYLE) // another game's ROM: not to be chosen
+        return sMenu.musicLocked;
+    if (setting == SETTING_SIZE)
+        return choice == PORT_SIZE_3DS && sMenu.page == PAGE_SUB_SCREEN;
+    return FALSE;
+}
+
+ALIGNED(4) static const u8 sRed[] = _("{COLOR RED}");
+
+static void PrintText(s32 x, s32 y, const u8 *str, u32 win, bool8 red)
+{
+    u8 buf[64];
+    if (red) {
+        s32 n = 0, i;
+        for (i = 0; sRed[i] != 0 && n < (s32)sizeof(buf) - 1; i++)
+            buf[n++] = sRed[i];
+        for (i = 0; str[i] != 0 && n < (s32)sizeof(buf) - 1; i++)
+            buf[n++] = str[i];
+        buf[n] = 0;
+        str = buf;
+    }
+    PrintStringOnWindow(x, y, str, win, 0);
+}
+
+static void Draw(void)
+{
+    u32 win = sMenu.windowId;
+    s32 i, y;
+
+    CallPrepareTextbox_8008C54(win);
+    sub_80073B8(win);
+
+    if (sMenu.page == PAGE_TOP) {
+        s32 c, skip = gPortConfig.frameSkip < 3 ? gPortConfig.frameSkip : PORT_FRAMESKIP_AUTO;
+        PrintStringOnWindow(16, 0, sTitleTop, win, 0);
+        y = GetMenuEntryYCoord(&sMenu.input, TOP_FRAMESKIP);
+        PrintStringOnWindow(8, y, sFrameSkip, win, 0);
+        for (c = 0; c < 3; c++)
+            PrintStringOnWindow(FRAMESKIP_X(c), y, sSettings[SETTING_FRAMESKIP].choices[c], win, 0);
+        AddDoubleUnderScoreHighlight(win, FRAMESKIP_X(skip), y + 10, GetStringLineWidth(sSettings[SETTING_FRAMESKIP].choices[skip]), COLOR_WHITE_2);
+        y = GetMenuEntryYCoord(&sMenu.input, TOP_DUALCORE);
+        PrintStringOnWindow(8, y, sDualCore, win, 0);
+        PrintStringOnWindow(FRAMESKIP_X(0), y, sOff, win, 0);
+        PrintStringOnWindow(FRAMESKIP_X(1), y, sOn, win, 0);
+        AddDoubleUnderScoreHighlight(win, FRAMESKIP_X(gPortConfig.dualCore ? 1 : 0), y + 10,
+                                     GetStringLineWidth(gPortConfig.dualCore ? sOn : sOff), COLOR_WHITE_2);
+        y = GetMenuEntryYCoord(&sMenu.input, TOP_GPU);
+        PrintStringOnWindow(8, y, sGpuDraw, win, 0);
+        PrintStringOnWindow(FRAMESKIP_X(0), y, sOff, win, 0);
+        PrintStringOnWindow(FRAMESKIP_X(1), y, sOn, win, 0);
+        AddDoubleUnderScoreHighlight(win, FRAMESKIP_X(gPortConfig.gpuDrawOff ? 0 : 1), y + 10,
+                                     GetStringLineWidth(gPortConfig.gpuDrawOff ? sOff : sOn), COLOR_WHITE_2);
+        y = GetMenuEntryYCoord(&sMenu.input, TOP_BUSY);
+        PrintStringOnWindow(8, y, sBusy, win, 0);
+        PrintStringOnWindow(FRAMESKIP_X(0), y, sWait, win, 0);
+        PrintStringOnWindow(FRAMESKIP_X(1), y, sSkip, win, 0);
+        AddDoubleUnderScoreHighlight(win, FRAMESKIP_X(gPortConfig.busyWait ? 0 : 1), y + 10,
+                                     GetStringLineWidth(gPortConfig.busyWait ? sWait : sSkip), COLOR_WHITE_2);
+        y = GetMenuEntryYCoord(&sMenu.input, TOP_MAIN_SCREEN);
+        PrintStringOnWindow(8, y, sMainScreen, win, 0);
+        if (sMenu.options->touchScreen)
+            AddDoubleUnderScoreHighlight(win, 80, y + 10, GetStringLineWidth(sTop), COLOR_WHITE_2);
+        else
+            AddDoubleUnderScoreHighlight(win, 120, y + 10, GetStringLineWidth(sBottom), COLOR_WHITE_2);
+        PrintStringOnWindow(8, GetMenuEntryYCoord(&sMenu.input, TOP_MAIN_SETTINGS), sMainScreenSettings, win, 0);
+        PrintStringOnWindow(8, GetMenuEntryYCoord(&sMenu.input, TOP_SUB_SETTINGS), sSubScreenSettings, win, 0);
+    }
+    else {
+        PrintStringOnWindow(16, 0, sMenu.page == PAGE_MAIN_SCREEN ? sTitleMain : sMenu.page == PAGE_CONTROLS ? sTitleControls
+                                   : sMenu.page == PAGE_MUSIC ? sTitleMusic : sTitleSub, win, 0);
+        for (i = 0; i < EntryCount(); i++) {
+            s32 setting = EntrySetting(i);
+            if (setting == ENTRY_PLAYER) {
+                PrintStringOnWindow(8, GetMenuEntryYCoord(&sMenu.input, i), sMusicPlayer, win, 0);
+                continue;
+            }
+            if (setting < 0) { // a volume: its percent (Left/Right: 10% less/more)
+                u8 text[24];
+                bool8 sfx = setting == ENTRY_SFX_VOLUME;
+                s32 v = (sfx ? gPortConfig.sfxVolume : gPortConfig.musicVolume) * 10;
+                y = GetMenuEntryYCoord(&sMenu.input, i);
+                PrintText(8, y, sfx ? sSfxVolume : sMusicVolume, win, sMenu.musicLocked);
+                snprintf((char *)text, sizeof(text), "%d%%", v);
+                PrintText(CHOICE_X(0), y, text, win, sMenu.musicLocked);
+                continue;
+            }
+            s32 c, value = *SettingValue(setting), first = FirstChoice(setting);
+            if (value >= sSettings[setting].count || value < first)
+                value = first;
+            y = GetMenuEntryYCoord(&sMenu.input, i);
+            PrintText(8, y, sSettings[setting].name, win, IsPlaceholder(setting, -1));
+            for (c = first; c < sSettings[setting].count; c++)
+                PrintText(CHOICE_X(c - first), y, sSettings[setting].choices[c], win, IsPlaceholder(setting, c));
+            AddDoubleUnderScoreHighlight(win, CHOICE_X(value - first), y + 10, GetStringLineWidth(sSettings[setting].choices[value]), COLOR_WHITE_2);
+        }
+    }
+
+    sub_80073E0(win);
+}
+
+// Shows the window for the current page, with the cursor on `entry`.
+static void ShowPage(s32 entry)
+{
+    s32 count = EntryCount();
+
+    RestoreSavedWindows(&sMenu.windows);
+    sMenu.windows.id[sMenu.windowId] = sWindow;
+    sub_8012D08(&sMenu.windows.id[sMenu.windowId], count);
+    ResetUnusedInputStruct();
+    ShowWindows(&sMenu.windows, TRUE, TRUE);
+    CreateMenuOnWindow(&sMenu.input, count, count, sMenu.windowId);
+    MoveMenuToEntryId(&sMenu.input, entry);
+    Draw();
+}
+
+void PortScreenMenu_Create(GameOptions *options)
+{
+    sMenu.options = options;
+    sMenu.windowId = 0;
+    sMenu.page = PAGE_TOP;
+    if (gPortConfig.layout[1][0] < PORT_SIZE_DS) // the second screen is DS-sized
+        gPortConfig.layout[1][0] = PORT_SIZE_DS;
+    sMenu.startConfig = gPortConfig;
+    ShowPage(0);
+}
+
+// Others > Controls Options: the same window, with only its page
+void PortControlMenu_Create(GameOptions *options)
+{
+    sMenu.options = options;
+    sMenu.windowId = 0;
+    sMenu.page = PAGE_CONTROLS;
+    sMenu.startConfig = gPortConfig;
+    ShowPage(0);
+}
+
+// Game Options > Music Options (on the title): Music Style, Sound Effects,
+// Music Volume, SFX Volume, and Music Player.
+// locked: pmd-blue.nds is another game's: GBA music, and the cursor can't go
+// to Music Style.
+void PortMusicMenu_Create(GameOptions *options, bool8 locked, s32 entry)
+{
+    sMenu.options = options;
+    sMenu.windowId = 0;
+    sMenu.page = PAGE_MUSIC;
+    sMenu.musicLocked = locked;
+    if (locked) {
+        gPortConfig.musicStyle = PORT_MUSIC_GBA;
+        gPortConfig.sfxStyle = PORT_MUSIC_GBA;
+        entry = MUSIC_PLAYER;
+    }
+    sMenu.startConfig = gPortConfig;
+    ShowPage(entry);
+}
+
+// Whether the port settings changed since the menu was opened.
+bool8 PortScreenMenu_Changed(void)
+{
+    return memcmp(&sMenu.startConfig, &gPortConfig, sizeof(gPortConfig)) != 0;
+}
+
+// 0: still open; 1: redrawn; 2: closed with B; 3: closed with A.
+u32 PortScreenMenu_Update(void)
+{
+    bool8 changed = FALSE;
+    s32 index = sMenu.input.menuIndex;
+
+    s32 input = GetMenuInput();
+
+    switch (input) {
+        case INPUT_B_BUTTON:
+        case INPUT_A_BUTTON: {
+            bool8 accept = input == INPUT_A_BUTTON;
+            if (sMenu.page == PAGE_CONTROLS) { // its own menu: closed
+                PlayMenuSoundEffect(accept ? MENU_SFX_ACCEPT : MENU_SFX_BACK);
+                return accept ? 3 : 2;
+            }
+            if (sMenu.page == PAGE_MUSIC) { // A on Music Player opens it
+                if (accept && index != MUSIC_PLAYER)
+                    break;
+                PlayMenuSoundEffect(accept ? MENU_SFX_ACCEPT : MENU_SFX_BACK);
+                return accept ? 3 : 2;
+            }
+            if (sMenu.page != PAGE_TOP) {
+                // back to the first page, on the entry that led here
+                PlayMenuSoundEffect(accept ? MENU_SFX_ACCEPT : MENU_SFX_BACK);
+                index = sMenu.page == PAGE_MAIN_SCREEN ? TOP_MAIN_SETTINGS : TOP_SUB_SETTINGS;
+                sMenu.page = PAGE_TOP;
+                ShowPage(index);
+                return 1;
+            }
+            if (accept && (index == TOP_MAIN_SETTINGS || index == TOP_SUB_SETTINGS)) {
+                PlayMenuSoundEffect(MENU_SFX_ACCEPT);
+                sMenu.page = index == TOP_MAIN_SETTINGS ? PAGE_MAIN_SCREEN : PAGE_SUB_SCREEN;
+                ShowPage(0);
+                return 1;
+            }
+            PlayMenuSoundEffect(accept ? MENU_SFX_ACCEPT : MENU_SFX_BACK);
+            return accept ? 3 : 2;
+        }
+        case INPUT_DPAD_LEFT:
+        case INPUT_DPAD_RIGHT: {
+            s32 step = input == INPUT_DPAD_LEFT ? -1 : 1;
+            if (sMenu.page == PAGE_TOP) {
+                if (index == TOP_FRAMESKIP) {
+                    s32 v = gPortConfig.frameSkip < 3 ? gPortConfig.frameSkip : PORT_FRAMESKIP_AUTO;
+                    gPortConfig.frameSkip = (u8)((v + 3 + step) % 3);
+                    changed = TRUE;
+                }
+                else if (index == TOP_GPU) {
+                    gPortConfig.gpuDrawOff = !gPortConfig.gpuDrawOff;
+                    changed = TRUE;
+                }
+                else if (index == TOP_BUSY) {
+                    gPortConfig.busyWait = !gPortConfig.busyWait;
+                    changed = TRUE;
+                }
+                else if (index == TOP_DUALCORE) {
+                    gPortConfig.dualCore = !gPortConfig.dualCore;
+                    changed = TRUE;
+                }
+                else if (index == TOP_MAIN_SCREEN) {
+                    sMenu.options->touchScreen = !sMenu.options->touchScreen;
+                    changed = TRUE;
+                }
+            }
+            else if (sMenu.page == PAGE_MUSIC && (index == MUSIC_PLAYER || sMenu.musicLocked)) {
+                // (Music Player has no choices; a locked Music Style stays GBA)
+            }
+            else if (sMenu.page == PAGE_MUSIC && (index == MUSIC_VOLUME || index == MUSIC_SFX_VOLUME)) {
+                // 10% a press (heard at once: the DS music, and this menu's own sounds)
+                u8 *v = index == MUSIC_VOLUME ? &gPortConfig.musicVolume : &gPortConfig.sfxVolume;
+                s32 n = *v + step;
+                if (n >= VOLUME_MIN && n <= VOLUME_MAX) {
+                    *v = (u8)n;
+                    changed = TRUE;
+                }
+            }
+            else {
+                s32 setting = EntrySetting(index);
+                s32 first = FirstChoice(setting);
+                s32 n = sSettings[setting].count - first;
+                u8 *value = SettingValue(setting);
+                s32 v = *value < first || *value >= sSettings[setting].count ? 0 : *value - first;
+                *value = (u8)(first + (v + n + step) % n);
+                Port_UpdateScreenSize();
+                changed = TRUE;
+            }
+            if (changed)
+                PlayMenuSoundEffect(MENU_SFX_NAVIGATE);
+            break;
+        }
+    }
+
+    // A locked Music Style: the cursor stays on Music Player
+    if (MenuCursorUpdate(&sMenu.input, !(sMenu.page == PAGE_MUSIC && sMenu.musicLocked)) || changed) {
+        Draw();
+        return 1;
+    }
+    return 0;
+}
+
+void PortScreenMenu_Destroy(void)
+{
+    sMenu.windows.id[sMenu.windowId] = sNoWindow;
+    ResetUnusedInputStruct();
+    ShowWindows(&sMenu.windows, TRUE, TRUE);
+}
+
+#endif // PLATFORM_3DS
