+// --- Extra Music Volumes -------------------------------------------------------
+//
+// The Explorers of Sky songs the floors play (Extra Music), each with its own
+// volume (on top of Extra Volume): A plays or stops one, L/R 1% less/more,
+// ZL/ZR 10%; START saves (extra-volumes.txt), B goes back (saving changes).
+// (The ROM browser's windows: the list, then the song and the controls.)
+
+#define EXTRA_SONGS_MAX 64
+static s32 sExtraSongs[EXTRA_SONGS_MAX];
+static s32 sExtraSongCount;
+static MenuInputStruct sExtraInput;
+static bool8 sExtraChanged;
+static const u8 *sExtraStatus;
+ALIGNED(4) static const u8 sExtraVolTitle[] = _("Extra Music Volumes");
+ALIGNED(4) static const u8 sExtraVolControls[] = _("A Play/Stop  L/R 1%  ZL/ZR 10%  START Save");
+ALIGNED(4) static const u8 sExtraVolSaved[] = _("{COLOR CYAN}Saved.{RESET}");
+ALIGNED(4) static const u8 sExtraVolNotSaved[] = _("{COLOR RED}Couldn't save the volumes.{RESET}");
+
+static void DrawExtraVolumes(void)
+{
+    MenuInputStruct *in = &sExtraInput;
+    u8 text[64];
+    char where[48], line[64];
+    s32 i;
+
+    CallPrepareTextbox_8008C54(ROM_LIST_WIN);
+    sub_80073B8(ROM_LIST_WIN);
+    PrintStringOnWindow(10, 0, sExtraVolTitle, ROM_LIST_WIN, 0);
+    snprintf((char *)text, sizeof(text), "%d/%d", in->currPage + 1, in->pagesCount > 0 ? in->pagesCount : 1);
+    PrintStringOnWindow(124, 0, text, ROM_LIST_WIN, 0);
+    for (i = 0; i < in->currPageEntries && sExtraSongCount > 0; i++) {
+        s32 song = sExtraSongs[in->currPage * in->entriesPerPage + i];
+        Port_ExtraMusicSongWhere(song, where, sizeof(where));
+        snprintf(line, sizeof(line), "%03d %s", (int)song, where);
+        MusicLabel(text, 30, line);
+        PrintStringOnWindow(8, GetMenuEntryYCoord(in, i), text, ROM_LIST_WIN, 0);
+        snprintf((char *)text, sizeof(text), "%d%%", Port_ExtraGainGet(song));
+        PrintStringOnWindow(176, GetMenuEntryYCoord(in, i), text, ROM_LIST_WIN, 0);
+    }
+    sub_80073E0(ROM_LIST_WIN);
+
+    CallPrepareTextbox_8008C54(ROM_INFO_WIN);
+    sub_80073B8(ROM_INFO_WIN);
+    if (sExtraSongCount > 0) {
+        s32 song = sExtraSongs[GET_CURRENT_MENU_ENTRY(sExtraInput)];
+        bool8 playing = Port_MusicPlaying() >= 0 && Port_MusicPlaying() == Port_ExtraMusicTrack(song);
+        snprintf((char *)text, sizeof(text), "%03d  %d%%  (all: %d%%)%s", (int)song, Port_ExtraGainGet(song),
+                 gPortConfig.extraVolume * 10, playing ? "  Playing" : "");
+        PrintStringOnWindow(4, 0, text, ROM_INFO_WIN, 0);
+    }
+    PrintStringOnWindow(4, 12, sExtraStatus != NULL ? sExtraStatus : sExtraVolControls, ROM_INFO_WIN, 0);
+    sub_80073E0(ROM_INFO_WIN);
+}
+
+static void CreateExtraVolumes(void)
+{
+    sExtraSongCount = Port_ExtraMusicSongs((int *)sExtraSongs, EXTRA_SONGS_MAX);
+    sExtraChanged = FALSE;
+    sExtraStatus = NULL;
+    sMusicPrevKeys = Port_KeysHeld();
+    CreateMenuOnWindow(&sExtraInput, sExtraSongCount > 0 ? sExtraSongCount : 1, ROM_PER_PAGE, ROM_LIST_WIN);
+    DrawExtraVolumes();
+}
+
+static void LeaveExtraVolumes(void)
+{
+    Port_MusicStop();
+    if (sMusicStoppedBgm) {
+        StartNewBGM(MUS_FILE_SELECT); // the title's music again
+        sMusicStoppedBgm = FALSE;
+    }
+    SetOptionsMenuState(OPTIONS_MENU_MUSIC_SETTINGS);
+}
+
+static void HandleExtraVolumes(void)
+{
+    u16 keys = Port_KeysHeld();
+    u16 pressed = keys & ~sMusicPrevKeys;
+    s32 step = (gRealInputs.pressed & L_BUTTON) ? -1 : (gRealInputs.pressed & R_BUTTON) ? 1
+             : (pressed & PORT_KEY_ZL) ? -10 : (pressed & PORT_KEY_ZR) ? 10 : 0;
+    s32 song = sExtraSongCount > 0 ? sExtraSongs[GET_CURRENT_MENU_ENTRY(sExtraInput)] : -1;
+
+    sMusicPrevKeys = keys;
+    if (step != 0 && song >= 0) { // (heard at once, if it's playing)
+        s32 g = Port_ExtraGainGet(song) + step, max = Port_ExtraGainMax();
+        Port_ExtraGainSet(song, g < 0 ? 0 : g > max ? max : g);
+        sExtraChanged = TRUE;
+        sExtraStatus = NULL;
+        PlayMenuSoundEffect(MENU_SFX_NAVIGATE);
+        DrawExtraVolumes();
+        return;
+    }
+    if (pressed & START_BUTTON) {
+        bool8 ok = Port_ExtraGainsSave();
+        sExtraStatus = ok ? sExtraVolSaved : sExtraVolNotSaved;
+        if (ok)
+            sExtraChanged = FALSE;
+        PlayMenuSoundEffect(ok ? MENU_SFX_ACCEPT : MENU_SFX_FAIL);
+        DrawExtraVolumes();
+        return;
+    }
+    switch (GetKeyPress(&sExtraInput)) {
+        case INPUT_B_BUTTON:
+            PlayMenuSoundEffect(MENU_SFX_BACK);
+            if (sExtraChanged)
+                Port_ExtraGainsSave();
+            LeaveExtraVolumes();
+            return;
+        case INPUT_A_BUTTON:
+            if (song < 0)
+                return;
+            if (Port_MusicPlaying() >= 0 && Port_MusicPlaying() == Port_ExtraMusicTrack(song))
+                Port_MusicStop();
+            else {
+                if (!sMusicStoppedBgm) {
+                    StopBGMusic(); // the title's music
+                    sMusicStoppedBgm = TRUE;
+                }
+                Port_MusicPlay(Port_ExtraMusicTrack(song));
+            }
+            sExtraStatus = NULL;
+            DrawExtraVolumes();
+            return;
+        default:
+            if (MenuCursorUpdate(&sExtraInput, TRUE)) {
+                sExtraStatus = NULL;
+                DrawExtraVolumes();
+            }
+            break;
+    }
+}
