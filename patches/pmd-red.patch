+    gPortHudLines = 0;
+}
+
+// The friend areas map and the world map (on the way to a dungeon), wide:
+// their two layers, kept whole as 64x64-tile arrays, drawn into the wide maps
+// around bgPos (the GBA screen's top left on the map).
+void Port_DrawWideMapArrays(const u16 (*bg2)[64], const u16 (*bg3)[64], s32 bgX, s32 bgY)
+{
+    s32 tx, ty;
+    s32 tx0 = (bgX - WIDE_OX) >> 3, ty0 = bgY >> 3;
+
+    for (ty = ty0; ty < ty0 + SCREEN_H / 8 + 1; ty++) {
+        for (tx = tx0; tx < tx0 + SCREEN_W / 8 + 1; tx++) {
