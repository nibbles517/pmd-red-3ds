+        cursor = entry;
+        cheat = sCheatListFirst[list] + entry;
+        if (cheat == CHEAT_EXP) {
+            s32 value = gPortCheats[CHEAT_EXP] <= CHEAT_EXP_MAX ? gPortCheats[CHEAT_EXP] : 0;
+            PrintCheatList(list, cursor, TRUE, value);
+            value = CheatsMenuInput();
+            if (value >= 0)
+                gPortCheats[CHEAT_EXP] = (u8)value;
+        }
+        else
+            gPortCheats[cheat] = !gPortCheats[cheat];
+    }
