+#ifdef PLATFORM_3DS
+// --- 3DS port: Music Style: DS ----------------------------------------------------
+//
+// With Blue Rescue Team's ROM (pmd-blue.nds) and Music Style: DS, each GBA
+// song matched with a DS track (port/core/music.c) plays as that track: the
+// GBA player still plays the song, silently (its volume, 0: m4a.c,
+// TrkVolPitSet), so that the game goes on as it always does, and the DS
+// track follows it: it starts with it, pauses while it does (for a fanfare),
+// follows its fades and stops with it. Songs without a match play as ever.
+
+bool8 gPortDsMusicOff; // Music Matching: the game's own music only
+static s8 sDsReady = -1; // -1: not looked at yet
+static s8 sSfxReady = -1; // (Sound Effects: DS, below)
+static bool8 sMuteBgm, sMuteFanfare;
+
+bool8 Port_DsMusicOn(void)
+{
+    if (gPortConfig.musicStyle != PORT_MUSIC_DS || gPortDsMusicOff)
+        return FALSE;
+    if (sDsReady < 0) // (once: the ROM is looked through at the first song)
+        sDsReady = Port_MusicOpen() > 0 && Port_MusicRomIsBlue();
+    return sDsReady > 0;
+}
+
+void Port_DsMusicRecheck(void)
+{
+    sDsReady = -1;
+    sSfxReady = -1;
+}
+
+// --- Sound Effects: DS ---
+//
+// The same for the sound effects (with Sound Effects: DS): each GBA sound
+// effect matched with a DS effect (Port_SfxMapGet) plays as that effect. The
+// game has 6 sound effect players (INDEX_SE1-6); each has a DS slot: when a
+// player starts an effect (m4a.c: m4aSongNumStart, once it isn't refused for
+// a higher priority effect playing), its DS effect starts over in that slot
+// and the GBA player plays on silently; the DS effect follows the player's
+// volume (fades), and stops when the player is stopped (m4a.c: m4aMPlayStop)
+// or its fade ends, or it starts another effect. One that ends by itself lets
+// the DS effect play on to its own end (the DS's may be longer), or, if it
+// loops, to its next loop (one that loops plays on while the GBA one does).
+
+s16 gPortMatchBgm = -1;
+static s16 sSfxTrack[PORT_SFX_SLOTS] = { -1, -1, -1, -1, -1, -1 }; // DS effect each player plays (-1: none)
+static u16 sSfxSerial[PORT_SFX_SLOTS];
+static u8 sSfxVolume[PORT_SFX_SLOTS] = { 64, 64, 64, 64, 64, 64 };
+static bool8 sSfxFading[PORT_SFX_SLOTS]; // (its end, then, stops the DS effect too)
+
+bool8 Port_DsSfxOn(void)
+{
+    if (gPortConfig.sfxStyle != PORT_MUSIC_DS || gPortDsMusicOff)
+        return FALSE;
+    if (sSfxReady < 0)
+        sSfxReady = Port_MusicOpen() > 0 && Port_MusicRomIsBlue();
+    return sSfxReady > 0;
+}
+
+void Port_SongStarted(u16 song, u32 playerIndex)
+{
+    s32 slot = (s32)playerIndex - INDEX_SE1;
+
+    if (slot < 0 || slot >= PORT_SFX_SLOTS)
+        return;
+    sSfxTrack[slot] = IsSoundEffect(song) && Port_DsSfxOn() ? Port_SfxMapGet(song) : -1;
+    sSfxSerial[slot]++;
+    sSfxVolume[slot] = 64;
+    sSfxFading[slot] = FALSE;
+}
+
+void Port_MPlayStopped(struct MusicPlayerInfo *mplayInfo)
+{
+    s32 i;
+
+    for (i = 0; i < PORT_SFX_SLOTS; i++)
+        if (mplayInfo == gMPlayTable[INDEX_SE1 + i].info)
+            sSfxTrack[i] = -1;
+}
+
+bool8 Port_MuteMPlay(struct MusicPlayerInfo *mplayInfo)
+{
+    s32 i;
+
+    if ((mplayInfo == &gMPlayInfo_BGM && sMuteBgm) || (mplayInfo == &gMPlayInfo_Fanfare && sMuteFanfare))
+        return TRUE;
+    for (i = 0; i < PORT_SFX_SLOTS; i++)
+        if (mplayInfo == gMPlayTable[INDEX_SE1 + i].info)
+            return sSfxTrack[i] >= 0;
+    return FALSE;
+}
+
+static void SetMute(struct MusicPlayerInfo *mplayInfo, bool8 *muted, bool8 mute)
+{
+    s32 i;
+
+    if (*muted == mute)
+        return;
+    *muted = mute;
+    for (i = 0; i < mplayInfo->trackCount; i++) // (their volumes again)
+        mplayInfo->tracks[i].flags |= MPT_FLG_VOLSET;
+}
+
+// The player's volume, 0-64: its fades and volume changes (m4aMPlayVolumeControl)
+static s32 PlayerVolume(struct MusicPlayerInfo *mplayInfo)
+{
+    s32 i;
+
+    for (i = 0; i < mplayInfo->trackCount; i++)
+        if (mplayInfo->tracks[i].flags & MPT_FLG_EXIST)
+            return mplayInfo->tracks[i].volX;
+    return 64;
+}
+
+static bool8 PlayerAudible(struct MusicPlayerInfo *mplayInfo)
+{
+    return (mplayInfo->status & MUSICPLAYER_STATUS_TRACK) != 0 && !(mplayInfo->status & MUSICPLAYER_STATUS_PAUSE);
+}
+
+static void Port_DsSfxFrame(void)
+{
+    s32 i, k;
+
+    for (i = 0; i < PORT_SFX_SLOTS; i++) {
+        struct MusicPlayerInfo *info = gMPlayTable[INDEX_SE1 + i].info;
+        bool8 ended = FALSE;
+        if (sSfxTrack[i] >= 0) {
+            if (!(info->status & MUSICPLAYER_STATUS_TRACK) || (info->status & MUSICPLAYER_STATUS_PAUSE)) {
+                if (sSfxFading[i]) // its fade ended
+                    sSfxTrack[i] = -1;
+                else // it ended by itself: the DS effect plays on to its end (or next loop)
+                    ended = TRUE;
+            }
+            else {
+                if (info->fadeOI != 0)
+                    sSfxFading[i] = TRUE;
+                for (k = 0; k < info->trackCount; k++)
+                    if (info->tracks[k].flags & MPT_FLG_EXIST) {
+                        sSfxVolume[i] = info->tracks[k].volX > 64 ? 64 : info->tracks[k].volX;
+                        break;
+                    }
+            }
+        }
+        Port_MusicSfxSlot(i, sSfxTrack[i], sSfxSerial[i], ended, sSfxVolume[i]);
+    }
+}
+
+s32 Port_ExtraMusicWant(void); // port_extra_music.c
+
+// Extra Music: Explorers of Sky's song for the dungeon floor, in place of its
+// own music. A change of song (to another one, or from the game's to one)
+// fades the one playing out, then the next starts EXTRA_CHANGE_FRAMES after,
+// as the game does between floors; the same song plays on from floor to
+// floor, whatever the game would have changed to; back to the game's music
+// (a Monster House...), it fades out as the game's starts.
+static s32 sExtraCur = -1;    // the Explorers of Sky song playing (slot track), or -1: the game's music
+static s32 sExtraTarget = -1; // the one to change to (sExtraCur: none)
+static s32 sExtraTime;        // frames into the change
+static bool8 sExtraGbaFade;   // the game's song turned down (m4aMPlayVolumeControl), to change from it
+#define EXTRA_FADE_FRAMES 30
+#define EXTRA_CHANGE_FRAMES 60
+
+// The Extra Music change this frame: its volume now (0-64)
+static s32 Port_ExtraMusicChange(void)
+{
+    s32 want = gPortDsMusicOff ? -1 : Port_ExtraMusicWant();
+    s32 fade = 64;
+
+    if (want != sExtraTarget) {
+        sExtraTarget = want;
+        sExtraTime = 0;
+    }
+    if (sExtraTarget != sExtraCur) {
+        sExtraTime++;
+        fade = sExtraTime >= EXTRA_FADE_FRAMES ? 0 : 64 * (EXTRA_FADE_FRAMES - sExtraTime) / EXTRA_FADE_FRAMES;
+        if (sExtraTime >= (sExtraTarget < 0 ? EXTRA_FADE_FRAMES : EXTRA_CHANGE_FRAMES)) {
+            sExtraCur = sExtraTarget;
+            fade = 64;
+        }
+    }
+    // from the game's song: it's turned down (the GBA player, and its DS
+    // track with it), then silent until the Explorers of Sky song starts
+    if (sExtraCur < 0 && sExtraTarget >= 0) {
+        m4aMPlayVolumeControl(&gMPlayInfo_BGM, 0xFF, fade * 4);
+        sExtraGbaFade = TRUE;
+    }
+    else if (sExtraGbaFade) {
+        m4aMPlayVolumeControl(&gMPlayInfo_BGM, 0xFF, 0x100);
+        sExtraGbaFade = FALSE;
+    }
+    return fade;
+}
+
+static void Port_DsMusicFrame(void)
+{
+    s32 bgm = -1, fanfare = -1;
+    s32 extraFade = Port_ExtraMusicChange();
+    bool8 extra = sExtraCur >= 0;
+
+    if (Port_DsSfxOn() || Port_DsMusicOn() || extra || sExtraTarget >= 0) { // (Music Options' volumes)
+        Port_MusicSetVolume(gPortConfig.musicVolume * 10);
+        Port_MusicSetSfxVolume(gPortConfig.sfxVolume * 10);
+    }
+    Port_ExtraMusicSetVolume(gPortConfig.extraVolume * 10);
+    Port_DsSfxFrame();
+    if (Port_DsMusicOn()) {
+        if (sCurrentBGSong != STOP_BGM)
+            bgm = Port_MusicMapGet(sCurrentBGSong);
+        if (sFanfareMusicPlayerState != 0 && sCurrentFanfareSong != STOP_SOUND_EFFECT)
+            fanfare = Port_MusicMapGet(sCurrentFanfareSong);
+    }
+    if (extra) {
+        // (its own: paused only for a fanfare, not by the game's song changing)
+        SetMute(&gMPlayInfo_BGM, &sMuteBgm, TRUE);
+        Port_MusicSlot(0, sExtraCur, TRUE, sFanfareMusicPlayerState != 0, extraFade);
+    }
+    else {
+        if (sExtraTarget >= 0 && extraFade == 0)
+            bgm = -1; // (the game's song faded out: silence, until the change)
+        SetMute(&gMPlayInfo_BGM, &sMuteBgm, bgm >= 0 || (sExtraTarget >= 0 && extraFade == 0));
+        Port_MusicSlot(0, bgm, TRUE, !PlayerAudible(&gMPlayInfo_BGM), PlayerVolume(&gMPlayInfo_BGM));
+    }
+    SetMute(&gMPlayInfo_Fanfare, &sMuteFanfare, fanfare >= 0);
+    if (gPortMatchBgm >= 0) // Sound Effect Matching: a song of the player's choice under the effects
+        Port_MusicSlot(0, gPortMatchBgm, TRUE, FALSE, 64);
+    // (once the GBA player plays it: from FANFARE_PLAYER_STATE_PLAYING, and
+    // on through state 4, which waits for it to end before the background
+    // music comes back; earlier it only played the one frame before then)
+    if (sFanfareMusicPlayerState != FANFARE_PLAYER_STATE_PLAYING && sFanfareMusicPlayerState != 4)
+        fanfare = -1;
+    Port_MusicSlot(1, fanfare, FALSE, FALSE, PlayerVolume(&gMPlayInfo_Fanfare));
+}
+#endif
