+
+static s32 MusicState(void)
+{
+    if (Port_MusicPlaying() >= 0)
+        return Port_MusicPaused() ? 2 : 1;
+    return sMusicTrack >= 0 ? 3 : 0;
+}
+
+// The volume buttons (`mask`: those for up, `maskDown`: those for down) in
+// steps of 10%, repeating while held: the sound effects' (sfx) or the
+// music's. Returns TRUE when the volume changed.
+static bool8 MusicVolumeKeys(u16 keys, u16 maskUp, u16 maskDown, bool8 sfx)
+{
+    bool8 changed = FALSE;
+    if (keys & (maskUp | maskDown)) {
+        s32 step = (keys & maskUp) ? 1 : -1;
+        if (sMusicVolumeHeld == 0 || (sMusicVolumeHeld >= 20 && (sMusicVolumeHeld - 20) % 5 == 0)) {
+            u8 *vol = sfx ? &gPortConfig.sfxVolume : &gPortConfig.musicVolume;
+            s32 v = *vol + step;
+            if (v >= MUSIC_VOLUME_MIN && v <= MUSIC_VOLUME_MAX) {
+                *vol = (u8)v;
+                if (sfx)
+                    Port_MusicSetSfxVolume(v * 10);
+                else
+                    Port_MusicSetVolume(v * 10);
+                changed = TRUE;
+            }
+        }
+        sMusicVolumeHeld++;
+    }
+    else
+        sMusicVolumeHeld = 0;
+    return changed;
+}
+
+// The Music Player's volume buttons: the volume of what plays (or, with
+// nothing playing, of the track the cursor is on): a sound effect's own
+static bool8 MusicPlayerVolumeIsSfx(void)
+{
+    s32 track = Port_MusicPlaying() >= 0 ? Port_MusicPlaying() : GET_CURRENT_MENU_ENTRY(sMusicInput);
+    return Port_MusicIsEffect(track) != 0;
+}
+
+static void DrawMusicInfo(void)
+{
+    u8 text[64];
+    unsigned ms = Port_MusicPosMs();
+    s32 state = MusicState();
+    static const u8 *const states[] = { sMusicNothing, sMusicNowPlaying, sMusicPausedText, sMusicStopped };
+
+    sMusicDrawnSecond = ms / 1000;
+    sMusicDrawnLoops = Port_MusicLoops();
+    sMusicDrawnState = state;
+    CallPrepareTextbox_8008C54(MUSIC_INFO_WIN);
+    sub_80073B8(MUSIC_INFO_WIN);
+    PrintStringOnWindow(4, 0, sMusicStatus != NULL ? sMusicStatus : states[state], MUSIC_INFO_WIN, 0);
+    if (Port_MusicRepeat())
+        PrintStringOnWindow(160, 0, sMusicRepeatOn, MUSIC_INFO_WIN, 0);
+    MusicLabel(text, 40, sMusicTrack >= 0 ? Port_MusicLabel(sMusicTrack) : Port_MusicRomTitle());
+    PrintStringOnWindow(4, 12, text, MUSIC_INFO_WIN, 0);
+    if (sMusicTrack >= 0)
+        snprintf((char *)text, sizeof(text), "Time %u:%02u", ms / 60000, (ms / 1000) % 60);
+    else
+        text[0] = '\0';
+    PrintStringOnWindow(4, 24, text, MUSIC_INFO_WIN, 0);
+    sMusicVolumeSfxShown = MusicPlayerVolumeIsSfx();
+    if (sMusicVolumeSfxShown)
+        snprintf((char *)text, sizeof(text), "SFX Volume %d%%", gPortConfig.sfxVolume * 10);
+    else
+        snprintf((char *)text, sizeof(text), "Music Volume %d%%", gPortConfig.musicVolume * 10);
+    PrintStringOnWindow(110, 24, text, MUSIC_INFO_WIN, 0);
+    PrintStringOnWindow(4, 36, sMusicControls, MUSIC_INFO_WIN, 0);
+    PrintStringOnWindow(4, 48, sMusicVolumeControls, MUSIC_INFO_WIN, 0);
+    sub_80073E0(MUSIC_INFO_WIN);
+}
+
+static void CreateMusicMenu(void)
+{
+    gPortRawXY = TRUE; // X stops, Y pauses (not A, with DS or 3DS buttons)
+    sMusicPrevKeys = Port_KeysHeld();
+    sMusicVolumeHeld = 0;
+    Port_MusicSetVolume(gPortConfig.musicVolume * 10);
+    Port_MusicSetSfxVolume(gPortConfig.sfxVolume * 10);
+    CreateMenuOnWindow(&sMusicInput, Port_MusicCount(), MUSIC_PER_PAGE, MUSIC_LIST_WIN);
+    MoveMenuToEntryId(&sMusicInput, sMusicCursor);
+    sMusicStatus = NULL;
+    DrawMusicList();
+    DrawMusicInfo();
+}
+
+static bool8 PlayMusicTrack(s32 track)
+{
+    sMusicTrack = track;
+    sMusicStatus = NULL;
+    if (!sMusicStoppedBgm) {
+        StopBGMusic(); // the title's music
+        sMusicStoppedBgm = TRUE;
+    }
+    if (!Port_MusicPlay(track)) {
+        sMusicStatus = sMusicCantLoad;
+        return FALSE;
+    }
+    return TRUE;
+}
+
+// The previous/next track (dir -1/+1), skipping those that don't load. At the
+// end of the list, a track that ended stops; a button press does nothing.
+static void AdvanceMusic(s32 dir, bool8 automatic)
+{
+    s32 track = sMusicTrack, tries;
+
+    for (tries = 0; tries < 64; tries++) {
+        s32 next = track + dir;
+        if (next < 0 || next >= Port_MusicCount())
+            break;
+        if (PlayMusicTrack(next))
+            return;
+        track = next;
+    }
+    if (automatic) {
+        Port_MusicStop();
+        sMusicStatus = sMusicEnd;
+    }
+}
+
+// The player, left: back to Music Options, on Music Player
+static void LeaveMusicMenu(void)
+{
+    sMusicCursor = GET_CURRENT_MENU_ENTRY(sMusicInput);
+    Port_MusicStop();
+    sMusicTrack = -1;
+    gPortRawXY = FALSE;
+    if (sMusicStoppedBgm) {
+        StartNewBGM(MUS_FILE_SELECT); // the title's music again
+        sMusicStoppedBgm = FALSE;
+    }
+    sMusicSettingsEntry = PORT_MUSIC_ENTRY_PLAYER;
+    SetOptionsMenuState(OPTIONS_MENU_MUSIC_SETTINGS);
+}
+
+// Music Options: Music Style (GBA or DS; GBA only for another game's ROM),
+// and Music Player. Leaving it saves the settings that changed.
+static void HandleMusicSettings(void)
+{
+    switch (PortScreenMenu_Update()) {
+        case 2: // B: back to Game Options
+            PortScreenMenu_Destroy();
+            Port_MusicClose();
+            Port_DsMusicRecheck(); // (Music Style: DS opens the ROM again)
+            LeaveSettings(memcmp(&sOpenedConfig, &gPortConfig, sizeof(gPortConfig)) != 0);
+            break;
+        case 3: // A on Music Player
+            PortScreenMenu_Destroy();
+            SetOptionsMenuState(OPTIONS_MENU_MUSIC);
+            break;
+        case 5: // A on Extra Music Volumes
+            PortScreenMenu_Destroy();
+            sMusicSettingsEntry = PORT_MUSIC_ENTRY_EXTRA_TRACKS;
+            SetOptionsMenuState(OPTIONS_MENU_EXTRA_VOLUMES);
+            break;
+        case 4: // Extra Music turned on, without Explorers of Sky's ROM: found first
+            PortScreenMenu_Destroy();
+            sRomFor = ROM_FOR_EXTRA;
+            sMusicSettingsEntry = PORT_MUSIC_ENTRY_EXTRA;
+            SetOptionsMenuState(OPTIONS_MENU_EXTRA_MISSING);
+            break;
+    }
+}
+
+static void HandleMusicMenu(void)
+{
+    u16 keys = Port_KeysHeld();
+    u16 pressed = keys & ~sMusicPrevKeys;
+    bool8 info = FALSE;
+
+    sMusicPrevKeys = keys;
+    // The volume: Circle Pad up/down or ZL/ZR, in steps of 10% (repeating
+    // while held, as the player's lists do): the music's, or a sound effect's
+    if (MusicVolumeKeys(keys, PORT_KEY_CPAD_UP | PORT_KEY_ZR, PORT_KEY_CPAD_DOWN | PORT_KEY_ZL, MusicPlayerVolumeIsSfx()))
+        info = TRUE;
+    if (gRealInputs.pressed & L_BUTTON) {
+        AdvanceMusic(-1, FALSE);
+        info = TRUE;
+    }
+    else if (gRealInputs.pressed & R_BUTTON) {
+        AdvanceMusic(1, FALSE);
+        info = TRUE;
+    }
+    else if (gRealInputs.pressed & SELECT_BUTTON) {
+        Port_MusicSetRepeat(!Port_MusicRepeat());
+        PlayMenuSoundEffect(MENU_SFX_TOGGLE);
+        info = TRUE;
+    }
+    else if (pressed & PORT_KEY_X) {
+        Port_MusicStop();
+        sMusicStatus = NULL;
+        info = TRUE;
+    }
+    else if (pressed & PORT_KEY_Y) {
+        Port_MusicSetPaused(!Port_MusicPaused());
+        info = TRUE;
+    }
+    else {
+        switch (GetKeyPress(&sMusicInput)) {
+            case INPUT_B_BUTTON:
+                PlayMenuSoundEffect(MENU_SFX_BACK);
+                LeaveMusicMenu();
+                return;
+            case INPUT_A_BUTTON:
+                PlayMusicTrack(GET_CURRENT_MENU_ENTRY(sMusicInput));
+                info = TRUE;
+                break;
+            default:
+                if (MenuCursorUpdate(&sMusicInput, TRUE))
+                    DrawMusicList();
+                break;
+        }
+    }
+    if (Port_MusicDone()) {
+        if (Port_MusicIsEffect(sMusicTrack))
+            Port_MusicStop(); // (an effect plays once: not on through hundreds of them)
+        else
+            AdvanceMusic(1, TRUE);
+        info = TRUE;
+    }
+    if (Port_MusicPlaying() != sMusicListPlaying)
+        DrawMusicList();
+    if (info || MusicPlayerVolumeIsSfx() != sMusicVolumeSfxShown || MusicState() != sMusicDrawnState || (s32)(Port_MusicPosMs() / 1000) != sMusicDrawnSecond
+        || Port_MusicLoops() != sMusicDrawnLoops)
+        DrawMusicInfo();
+}
+
+// The loaded ROM's DS Menu icon at twice its size, in a window like a
+// speaker's portrait, centred: its 64x64 picture as an uncompressed "AT3P"
+// (DecompressAT's N mode), in BG palette 14.
+static MonPortraitMsg *MusicIconPortrait(void)
+{
+    static u8 sIcon[7 + 64 * 32];
+    static RGB_Struct sIconColors[16];
+    static PortraitGfx sIconGfx;
+    static MonPortraitMsg sPortrait;
+    u8 colors[16 * 4];
+    s32 i;
+
+    if (!Port_MusicIcon(sIcon + 7, colors))
+        return NULL;
+    memcpy(sIcon, "AT3PN", 5);
+    sIcon[5] = (64 * 32) & 0xFF;
+    sIcon[6] = (64 * 32) >> 8;
+    for (i = 0; i < 16; i++) {
+        sIconColors[i].r = colors[i * 4];
+        sIconColors[i].g = colors[i * 4 + 1];
+        sIconColors[i].b = colors[i * 4 + 2];
+        sIconColors[i].unk4 = 0;
+    }
+    memset(&sIconGfx, 0, sizeof(sIconGfx));
+    sIconGfx.sprites[0].pal = sIconColors;
+    sIconGfx.sprites[0].gfx = sIcon;
+    sPortrait.faceFile = NULL;
+    sPortrait.faceData = &sIconGfx;
+    sPortrait.spriteId = 0;
+    sPortrait.flip = FALSE;
+    sPortrait.unkE = PORT_PORTRAIT_ICON; // 8x8 tiles: the border fits the icon
+    sPortrait.pos.x = (30 - 8) / 2; // in the middle, above the text box
+    sPortrait.pos.y = 4;
+    return &sPortrait;
+}
