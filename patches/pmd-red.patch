+static bool8 SaveMatches(void)
+{
+    static int ids[MATCH_SONGS];
+    static const char *names[MATCH_SONGS];
+    static int sfx[ARRAY_COUNT(sSfxIds)];
+    s32 i;
+
+    if (sMatchSfx) {
+        for (i = 0; i < sSfxCount; i++)
+            sfx[i] = sSfxIds[i];
+        return Port_SfxMapSave(sfx, sSfxCount);
+    }
+
+    for (i = 0; i < MATCH_SONGS; i++) {
+        ids[i] = sMatchSongs[i].id;
+        names[i] = sMatchSongs[i].name;
+    }
+    return Port_MusicMapSave(ids, names, MATCH_SONGS);
+}
+
+// Sound Effect Matching: ZL/ZR, the DS effect's own volume (10% a press,
+// 0-500%), played again to hear it (all the effects' volume: Music Options');
+// SELECT, a DS song under the effects (on, off), SELECT held with L/R or
+// ZL/ZR another one.
+static s16 sMatchBgmLast = -1; // (the song SELECT plays again)
+
+static bool8 MatchSfxKeys(u16 keys, u16 pressed, s32 song)
+{
+    s32 track = MatchGet(song);
+    if (keys & SELECT_BUTTON) {
+        s32 step = (gRealInputs.pressed & L_BUTTON) ? -1 : (gRealInputs.pressed & R_BUTTON) ? 1
+                 : (pressed & PORT_KEY_ZL) ? -10 : (pressed & PORT_KEY_ZR) ? 10 : 0;
+        if (step != 0 && Port_MusicSongCount() > 0) {
+            s32 n = Port_MusicSongCount(), cur = gPortMatchBgm >= 0 ? gPortMatchBgm : sMatchBgmLast >= 0 ? sMatchBgmLast : 0;
+            cur = ((cur + step) % n + n) % n;
+            gPortMatchBgm = sMatchBgmLast = (s16)cur;
+            sMatchStatus = NULL;
+            return TRUE;
+        }
+    }
+    if (pressed & SELECT_BUTTON) { // (on, off)
+        if (gPortMatchBgm >= 0)
+            gPortMatchBgm = -1;
+        else if (Port_MusicSongCount() > 0)
+            gPortMatchBgm = sMatchBgmLast = sMatchBgmLast >= 0 ? sMatchBgmLast : 0;
+        sMatchStatus = NULL;
+        return TRUE;
+    }
+    if (pressed & (PORT_KEY_ZL | PORT_KEY_ZR)) {
+        if (track < 0)
+            return TRUE; // (nothing to set: and not another DS effect either)
+        s32 g = Port_SfxGainGet(track) + ((pressed & PORT_KEY_ZR) ? 10 : -10);
+        g = g < 0 ? 0 : g > 500 ? 500 : g;
+        Port_SfxGainSet(track, g);
+        PlayMatchDs(song); // (heard at once)
+        sMatchStatus = NULL;
+        return TRUE;
+    }
+    return FALSE;
+}
