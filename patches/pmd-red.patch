index 172f2be9..c3dfe0d5 100644
--- a/src/flash.c
+++ b/src/flash.c
@@ -5,6 +5,53 @@
 
 EWRAM_INIT bool8 gFlashEnabled = {0};
 
+#ifdef PLATFORM_3DS
+// The port keeps the 128 KiB flash image in memory and writes it to the SD card
+// (port/core/save.c); the image is byte-compatible with a GBA emulator's .sav.
+void Port_FlashInit(void);
+void Port_FlashRead(u32 offset, void *dest, u32 size);
+void Port_FlashWrite(u32 offset, const void *src, u32 size);
+void Port_FlashErase(void);
+
+void InitFlash(void)
+{
+    Port_FlashInit();
+    gFlashEnabled = TRUE;
+}
+
+void ClearFlashData(void)
+{
+    if (gFlashEnabled)
+        Port_FlashErase();
+}
+
+s32 ReadFlashData(s32 sector, u8 *dest, s32 size)
+{
+    if (!gFlashEnabled)
+        return 3;
+    Port_FlashRead((u32)sector * 0x1000, dest, (u32)size);
+    return 0;
+}
+
+s32 WriteFlashData(s32 sector, u8 *src, s32 size)
+{
+    u8 buffer[0x1000];
+    s32 whole = size & ~0xFFF;
+
+    if (!gFlashEnabled)
+        return 3;
+    // As on hardware, a partial last sector is padded with erased bytes.
+    if (whole > 0)
+        Port_FlashWrite((u32)sector * 0x1000, src, (u32)whole);
+    if (size > whole) {
+        MemoryFill8(buffer, 0xFF, 0x1000);
+        MemoryCopy8(buffer, src + whole, size - whole);
+        Port_FlashWrite((u32)(sector + (whole >> 12)) * 0x1000, buffer, 0x1000);
+    }
+    return 0;
+}
+#else
+
 extern FlashIntrFunc *GetInterruptHandler(s32);
 
 static u8 TryProgramSector(s32, u8 *);
@@ -90,3 +137,4 @@ static u8 TryProgramSector(s32 sector, u8 *src)
 
     return FALSE;
 }
+#endif // PLATFORM_3DS
