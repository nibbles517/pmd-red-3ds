+                .header = &header,
+            },
+            [1] = WIN_TEMPLATE_DUMMY,
+            [2] = WIN_TEMPLATE_DUMMY,
+            [3] = WIN_TEMPLATE_DUMMY,
+        }
+    };
+
+    header.count = 1;
+    header.currId = 0;
+    header.f3 = 0;
+    gDungeonMenu.currPageEntries = rows;
+    gDungeonMenu.entriesPerPage = rows;
+    gDungeonMenu.currPage = 0;
+    gDungeonMenu.pagesCount = 0;
+    gDungeonMenu.unk4 = 0;
+    gDungeonMenu.firstEntryY = 16;
+    gDungeonMenu.leftRightArrowsPos.x = 0;
+    gDungeonMenu.leftRightArrowsPos.y = 0;
+    gDungeonMenu.unk14.x = 0;
+    gDungeonMenu.windowId = 0;
+    ResetTouchScreenMenuInput(&gDungeonMenu.touchScreen);
+    windows.id[0].height = windows.id[0].totalHeight = CalcEntriesTotalHeight(rows, DEFAULT_MENU_ENTRY_HEIGHT) + 2;
+    header.width = 14; // room for "Main Screen Settings"
+    windows.id[0].width = 26; // and for four Size choices
+    DungeonShowWindows(&windows, TRUE);
+    sub_80137B0(&gDungeonMenu, 0);
+
+    sub_80073B8(0);
+    PrintFormattedStringOnWindow(16, 0, sPortPage == PAGE_WINDOWS ? gOptionsOthersTextPtr : sPortTitles[sPortPage], 0, '\0');
+    for (i = 0; i < rows; i++) {
+        const struct PortRow *row = &sPortRows[sPortPage][i];
+        s32 y = GetMenuEntryYCoord(&gDungeonMenu, i);
+        s32 v = sPortValues[sPortPage][i];
+        PrintPortText(8, y, row->label, row->count != 0 && row->placeholder == (1 << row->count) - 1);
+        if (row->count == 0)
+            continue; // a page of its own
+        for (c = 0; c < row->count; c++)
+            PrintPortText(row->x0 + c * row->step, y, row->choices[c], (row->placeholder >> c) & 1);
+        AddDoubleUnderScoreHighlight(0, row->x0 + v * row->step, y + 10, GetStringLineWidth(row->choices[v]), 7);
+    }
+    sub_80073E0(0);
+}
