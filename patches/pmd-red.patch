+#ifdef PLATFORM_3DS
+// 3DS port, wide view (port_view.h): the layers are also drawn into maps
+// wide enough for the screen (up to 320x240) of the map around the camera, which the port draws
+// instead of the 32x32 ones. Past the map's edges (maps smaller than the view)
+// is black.
+static u16 sPortWideMaps[2][64 * 64]; // BG2, BG3
+
+bool8 gPortGroundNarrow; // set by ground_map.c for screens made as maps
+bool8 gPortGroundEdges; // ... for those whose edges go on past the map (THE END)
+// ... and for the title: its sky and clouds' layer (repeated across as it
+// scrolls) carries its top and bottom rows on, and the layer of the logo, the
+// sun and the sea its edge columns and its bottom row (the sea, wider and
+// deeper); nothing black
+bool8 gPortGroundTitle;
+bool8 Port_ScriptPickerOpen(void);
+// The weather's layers (ground_weather.c: drawn over the map, following its
+// camera; Deep-Sea Floor's water) past their edges are as the GBA draws them
+// there: repeated across, nothing below or above (not black).
+extern GroundBg *gUnknown_3001B78; // ground_weather.c
+
+static void Port_RenderWideLayers(MapRender *mapRender)
+{
+    s32 j;
+    s32 cd = mapRender->chunkDimensions == CHUNK_DIMENSIONS_2x2 ? 2
+           : mapRender->chunkDimensions == CHUNK_DIMENSIONS_3x3 ? 3 : 0;
+    s32 mapW = mapRender->mapSizePixels.x / 8, mapH = mapRender->mapSizePixels.y / 8;
+    s32 tx0 = (mapRender->cameraPos.x - WIDE_OX) >> 3, ty0 = mapRender->cameraPos.y >> 3;
+
+    bool8 overlay;
+    s32 titleY0 = mapRender->cameraPos.y >> 3;
+
+    if (gPortGroundNarrow || !PORT_WIDE_SIZE)
+        return;
+    overlay = gUnknown_3001B78 != NULL && (u8 *)mapRender >= (u8 *)gUnknown_3001B78 && (u8 *)mapRender < (u8 *)(gUnknown_3001B78 + 1);
+    for (j = 0; j < mapRender->numBgs; j++) {
+        u16 *tilemap = mapRender->bgTilemaps[j];
+        const u16 *chunks = mapRender->chunkMappings[j];
+        s32 bg, tx, ty;
+        u16 *dst;
+
+        if (tilemap == NULL)
+            continue;
+        bg = (tilemap - &gBgTilemaps[0][0][0]) / (32 * 32);
+        if (bg < 2 || bg > 3)
+            continue;
+        dst = sPortWideMaps[bg - 2];
+        if (cd == 0 || chunks == NULL) {
+            for (ty = ty0; ty < ty0 + SCREEN_H / 8 + 1; ty++)
+                for (tx = tx0; tx < tx0 + SCREEN_W / 8 + 1; tx++)
+                    dst[(ty & 63) * 64 + (tx & 63)] = 0;
+        }
+        else {
+            // Each column's chunk and place in it, worked out once (no
+            // divisions in the loop: this runs every frame).
+            s16 colChunk[SCREEN_W_MAX / 8 + 1], colIn[SCREEN_W_MAX / 8 + 1];
+            for (tx = tx0; tx < tx0 + SCREEN_W / 8 + 1; tx++) {
+                s32 mx = tx, i = tx - tx0;
+                if (mapRender->wrapAround || overlay)
+                    mx = ((mx % mapW) + mapW) % mapW;
+                else if (gPortGroundTitle || gPortGroundEdges) // (the logo's layer: its edge columns on, the sea's band)
+                    mx = mx < 0 ? 0 : mx >= mapW ? mapW - 1 : mx;
+                if (mx < 0 || mx >= mapW) {
+                    colChunk[i] = -1;
+                    colIn[i] = 0;
+                } else {
+                    colChunk[i] = mx / cd;
+                    colIn[i] = mx % cd;
+                }
+            }
+            // (the title: rows above too, which port/core/frame.c draws above the
+            // GBA's picture as it moves it down)
+            for (ty = gPortGroundTitle ? ty0 - 6 : ty0; ty < ty0 + SCREEN_H / 8 + 1; ty++) {
+                s32 my = ty;
+                u16 *out = &dst[(ty & 63) * 64];
+                const u16 *chunkRow;
+                const u16 *tiles;
+                if (gPortGroundTitle) // (the rows the GBA shows, the bottom's on: more sea; the sky's top on)
+                    my = my > titleY0 + 19 ? titleY0 + 19 : my >= titleY0 ? my : mapRender->wrapAround ? titleY0 : -1;
+                else if (mapRender->wrapAround)
+                    my = ((my % mapH) + mapH) % mapH;
+                else if (gPortGroundEdges)
+                    my = my < 0 ? 0 : my >= mapH ? mapH - 1 : my;
+                if (my < 0 || my >= mapH) {
+                    for (tx = tx0; tx < tx0 + SCREEN_W / 8 + 1; tx++)
+                        out[tx & 63] = (overlay || gPortGroundTitle) ? 0 : PORT_WIDE_BLACK;
+                    continue;
+                }
+                chunkRow = &chunks[(my / cd) * 64];
+                tiles = &mapRender->tileMappings[(my % cd) * cd];
+                for (tx = tx0; tx < tx0 + SCREEN_W / 8 + 1; tx++) {
+                    s32 i = tx - tx0;
+                    out[tx & 63] = colChunk[i] < 0 ? (gPortGroundTitle ? 0 : PORT_WIDE_BLACK) : tiles[chunkRow[colChunk[i]] * 9 + colIn[i]];
+                }
+            }
+        }
+        gPortWideBg[bg].map = dst;
+        gPortWideBg[bg].scrollX = mapRender->cameraPos.x;
+        gPortWideBg[bg].scrollY = mapRender->cameraPos.y;
+        // (the title's logo, in Fit and 3DS sizes: 8 lines higher than the
+        // rest, which port/core/frame.c moves down)
+        if (gPortGroundTitle && !mapRender->wrapAround && SCREEN_H >= 240)
+            gPortWideBg[bg].scrollY += 8;
+    }
+    // (not under Scene Select's list, back from a scene with the map still
+    // loaded: its windows are laid out for the GBA-sized view)
+    if (Port_ScriptPickerOpen())
+        return;
+    gPortWideView = 2;
+    gPortHudLines = 0;
+}
+
+// The friend areas map and the world map (on the way to a dungeon), wide:
+// their two layers, kept whole as 64x64-tile arrays, drawn into the wide maps
+// around bgPos (the GBA screen's top left on the map).
+void Port_DrawWideMapArrays(const u16 (*bg2)[64], const u16 (*bg3)[64], s32 bgX, s32 bgY)
+{
+    s32 tx, ty;
+    s32 tx0 = (bgX - WIDE_OX) >> 3, ty0 = bgY >> 3;
+
+    for (ty = ty0; ty < ty0 + SCREEN_H / 8 + 1; ty++) {
+        for (tx = tx0; tx < tx0 + SCREEN_W / 8 + 1; tx++) {
+            s32 i = (ty & 63) * 64 + (tx & 63);
+            bool8 in = tx >= 0 && ty >= 0 && tx < 64 && ty < 64;
+            sPortWideMaps[0][i] = in ? bg2[ty][tx] : 0;
+            sPortWideMaps[1][i] = in ? bg3[ty][tx] : PORT_WIDE_BLACK;
+        }
+    }
+}
+
+void Port_ShowWideMapArrays(s32 bgX, s32 bgY)
+{
+    s32 bg;
+    for (bg = 2; bg <= 3; bg++) {
+        gPortWideBg[bg].map = sPortWideMaps[bg - 2];
+        gPortWideBg[bg].scrollX = bgX;
+        gPortWideBg[bg].scrollY = bgY;
+    }
+    gPortWideView = 2;
+    gPortHudLines = 0;
+}
+
+// ... and where to keep bgPos: the GBA's rules (the Pokémon at least 48
+// pixels from the edges, the map's edges not passed), for the wide screen.
+// maxX/maxY: the GBA's largest bgPos.
+void Port_WideMapFollow(DungeonPos *bgPos, const DungeonPos *mon, s32 maxX, s32 maxY)
+{
+    s32 left = -WIDE_OX, right = SCREEN_W - WIDE_OX; // the screen in GBA x
+
+    if (mon->x - bgPos->x < left + 48)
+        bgPos->x = mon->x - (left + 48);
+    else if (mon->x - bgPos->x > right - 48)
+        bgPos->x = mon->x - (right - 48);
+    if (mon->y - bgPos->y < 48)
+        bgPos->y = mon->y - 48;
+    else if (mon->y - bgPos->y > SCREEN_H - 48)
+        bgPos->y = mon->y - (SCREEN_H - 48);
+
+    maxX -= SCREEN_W - DISPLAY_WIDTH - WIDE_OX; // the map's right edge stays at the screen's
+    maxY -= SCREEN_H - DISPLAY_HEIGHT;
+    if (bgPos->x < WIDE_OX)
+        bgPos->x = WIDE_OX;
+    if (bgPos->y < 0)
+        bgPos->y = 0;
+    if (bgPos->x > maxX)
+        bgPos->x = maxX;
+    if (bgPos->y > maxY)
+        bgPos->y = maxY;
+}
+#endif
+
 static void CallMapTilemapRenderFunc(MapRender *mapRender)
 {
     mapRender->tilemapRenderFunc(mapRender);
+#ifdef PLATFORM_3DS
+    Port_RenderWideLayers(mapRender);
+#endif
 }
 
