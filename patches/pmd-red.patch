+static void PrintPortText(s32 x, s32 y, const u8 *str, bool8 red)
+{
+    u8 buf[64];
+    if (red) {
+        // "{COLOR RED}" and the text
+        s32 n = 0, i;
+        for (i = 0; sTextColorRed[i] != 0 && n < (s32)sizeof(buf) - 1; i++)
+            buf[n++] = sTextColorRed[i];
+        for (i = 0; str[i] != 0 && n < (s32)sizeof(buf) - 1; i++)
+            buf[n++] = str[i];
+        buf[n] = 0;
+        str = buf;
+    }
+    PrintFormattedStringOnWindow(x, y, str, 0, '\0');
+}
