+static void PortLoadValues(void)
+{
+    sPortValues[PAGE_WINDOWS][0] = sChangedGameOptions.windowColor < 3 ? sChangedGameOptions.windowColor : 0;
+    sPortValues[PAGE_WINDOWS][1] = sChangedGameOptions.playerGender != MALE;
+    sPortValues[PAGE_LAYOUT][0] = gPortConfig.layoutSubScreen & 3;
+    sPortValues[PAGE_LAYOUT][1] = sChangedGameOptions.mapOption <= MAP_OPTION_SHADE ? sChangedGameOptions.mapOption : 0;
+    sPortValues[PAGE_LAYOUT][2] = gPortConfig.layoutInfo ? 0 : 1; // On, Off
+    sPortValues[PAGE_GRAPHICS][0] = gPortConfig.frameSkip < 3 ? gPortConfig.frameSkip : PORT_FRAMESKIP_AUTO;
+    sPortValues[PAGE_GRAPHICS][1] = gPortConfig.dualCore != 0;
+    sPortValues[PAGE_GRAPHICS][2] = sChangedGameOptions.touchScreen ? 0 : 1; // Top, Bottom
+    sPortValues[PAGE_MAIN_SETTINGS][0] = gPortConfig.layout[0][0] & 3;
+    sPortValues[PAGE_MAIN_SETTINGS][1] = gPortConfig.layout[0][1] < 3 ? gPortConfig.layout[0][1] : 0;
+    sPortValues[PAGE_SUB_SETTINGS][0] = gPortConfig.subScreenDisabled != 0; // Yes, No
+    sPortValues[PAGE_SUB_SETTINGS][1] = gPortConfig.layout[1][0] >= PORT_SIZE_DS && gPortConfig.layout[1][0] <= PORT_SIZE_3DS
+                                        ? gPortConfig.layout[1][0] - PORT_SIZE_DS : 0;
+    sPortValues[PAGE_SUB_SETTINGS][2] = gPortConfig.layout[1][1] < 3 ? gPortConfig.layout[1][1] : 0;
+    sPortValues[PAGE_CONTROLS][0] = gPortConfig.buttonStyle < 3 ? gPortConfig.buttonStyle : PORT_BUTTONS_GBA;
+    sPortValues[PAGE_CONTROLS][1] = gPortConfig.touchScreenOff != 0; // On, Off
+    memcpy(sPortOpened, sPortValues, sizeof(sPortValues));
+}
+
+// Whether the port's own settings (all but the game's options) changed.
+static bool8 PortValuesChanged(void)
+{
+    return sPortOpened[PAGE_LAYOUT][0] != sPortValues[PAGE_LAYOUT][0]
+        || sPortOpened[PAGE_LAYOUT][2] != sPortValues[PAGE_LAYOUT][2]
+        || memcmp(sPortOpened[PAGE_GRAPHICS], sPortValues[PAGE_GRAPHICS], 2) != 0
+        || memcmp(sPortOpened[PAGE_MAIN_SETTINGS], sPortValues[PAGE_MAIN_SETTINGS], PAGE_ROWS) != 0
+        || memcmp(sPortOpened[PAGE_SUB_SETTINGS], sPortValues[PAGE_SUB_SETTINGS], PAGE_ROWS) != 0
+        || memcmp(sPortOpened[PAGE_CONTROLS], sPortValues[PAGE_CONTROLS], PAGE_ROWS) != 0;
+}
+
+// As outside dungeons (options_menu1.c): a change takes effect at once...
+static GameOptions sOpenedGameOptions;
+
+static void PortApplyNow(void)
+{
+    if (sPortValues[PAGE_LAYOUT][1] != sPortOpened[PAGE_LAYOUT][1] || sPortPage == PAGE_LAYOUT)
+        sChangedGameOptions.mapOption = sPortValues[PAGE_LAYOUT][1];
+    u8 wasSize = gPortConfig.layout[0][0];
+    if (sPortPage == PAGE_WINDOWS) {
+        sChangedGameOptions.windowColor = sPortValues[PAGE_WINDOWS][0];
+        sChangedGameOptions.playerGender = sPortValues[PAGE_WINDOWS][1] ? FEMALE : MALE;
+    }
+    if (sPortPage == PAGE_GRAPHICS)
+        sChangedGameOptions.touchScreen = sPortValues[PAGE_GRAPHICS][2] == 0;
+    *gGameOptionsRef = sChangedGameOptions;
+    gPortConfig.layoutSubScreen = sPortValues[PAGE_LAYOUT][0];
+    gPortConfig.layoutInfo = sPortValues[PAGE_LAYOUT][2] == 0;
+    gPortConfig.frameSkip = sPortValues[PAGE_GRAPHICS][0];
+    gPortConfig.dualCore = sPortValues[PAGE_GRAPHICS][1];
+    gPortConfig.layout[0][0] = sPortValues[PAGE_MAIN_SETTINGS][0];
+    gPortConfig.layout[0][1] = sPortValues[PAGE_MAIN_SETTINGS][1];
+    gPortConfig.subScreenDisabled = sPortValues[PAGE_SUB_SETTINGS][0];
+    gPortConfig.layout[1][0] = PORT_SIZE_DS + sPortValues[PAGE_SUB_SETTINGS][1];
+    gPortConfig.layout[1][1] = sPortValues[PAGE_SUB_SETTINGS][2];
+    gPortConfig.buttonStyle = sPortValues[PAGE_CONTROLS][0];
+    gPortConfig.touchScreenOff = sPortValues[PAGE_CONTROLS][1];
+    sub_803E13C();
+    LoadDungeonMapPalette();
+    // Size changed: the floor is kept in a different map in GBA size
+    // (dungeon_map_access.c), and the wide view's size and camera differ, so
+    // it is drawn again.
+    if (wasSize != gPortConfig.layout[0][0]) {
+        Port_UpdateScreenSize();
+        UpdateCamera(0);
+        UpdateTrapsVisibility();
+    }
+}
